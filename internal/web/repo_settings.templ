package web

import (
	"github.com/rusik69/govnohub/internal/issue"
	"github.com/rusik69/govnohub/internal/repo"
	"github.com/rusik69/govnohub/internal/webhook"
)

type WebhookRow struct {
	ID     string
	URL    string
	Events string
	Active bool
}

type WebhookWithDeliveries struct {
	Hook       WebhookRow
	Deliveries []webhook.Delivery
}

type RepoSettingsData struct {
	Header            RepoHeaderData
	Nav               RepoNavData
	CSRF              string
	Webhooks          []WebhookWithDeliveries
	Collaborators     []repo.Collaborator
	ProtectedBranches []repo.ProtectedBranch
	Labels            []issue.Label
}

templ RepoSettingsPage(layout LayoutData, data RepoSettingsData) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, Flash: layout.Flash, FlashErr: layout.FlashErr, FullWidth: true,
		Content: RepoSettingsContent(data),
	})
}

templ RepoSettingsContent(data RepoSettingsData) {
	@RepoPageShell(data.Header, data.Nav)
	<div class="max-w-7xl mx-auto">
		<h1 class="text-xl font-bold mb-4">Settings</h1>

	<section class="mb-6">
		<h2 class="text-lg font-semibold mb-3">Collaborators</h2>
		<form method="post" action={ templ.SafeURL("/" + data.Nav.Owner + "/" + data.Nav.Repo + "/settings/collaborator") } class="card p-4 mb-4 flex gap-3">
			@CSRFInput(data.CSRF)
			<input type="text" name="username" placeholder="Username" required class="input flex-1"/>
			<select name="permission" class="input">
				<option value="read">read</option>
				<option value="write">write</option>
			</select>
			<button type="submit" class="btn">Add</button>
		</form>
		if len(data.Collaborators) == 0 {
			@EmptyState("No collaborators")
		} else {
			<table class="card mb-4">
				<thead><tr><th>User</th><th>Permission</th><th></th></tr></thead>
				<tbody>
					for _, c := range data.Collaborators {
						<tr>
							<td>{ c.Username }</td>
							<td>{ c.Permission }</td>
							<td>
								<form method="post" action={ templ.SafeURL("/" + data.Nav.Owner + "/" + data.Nav.Repo + "/settings/collaborator/" + c.Username + "/remove") } onsubmit="return confirm('Remove this collaborator?')">
									@CSRFInput(data.CSRF)
									<button type="submit" class="btn-secondary text-sm">Remove</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>

	<section class="mb-6">
		<h2 class="text-lg font-semibold mb-3">Branch protection</h2>
		<form method="post" action={ templ.SafeURL("/" + data.Nav.Owner + "/" + data.Nav.Repo + "/settings/protection") } class="card p-4 mb-4 flex flex-col gap-3">
			@CSRFInput(data.CSRF)
			<input type="text" name="branch" placeholder="Branch name" required class="input"/>
			<input type="text" name="required_checks" placeholder="Required checks (comma-separated job IDs)" class="input"/>
			<input type="number" name="require_reviews" placeholder="Required reviews" min="0" value="0" class="input"/>
			<button type="submit" class="btn self-start">Protect branch</button>
		</form>
		if len(data.ProtectedBranches) == 0 {
			@EmptyState("No protected branches")
		} else {
			<table class="card mb-4">
				<thead><tr><th>Branch</th><th>Required checks</th><th>Reviews</th></tr></thead>
				<tbody>
					for _, pb := range data.ProtectedBranches {
						<tr>
							<td>{ pb.BranchName }</td>
							<td class="text-sm">{ joinStrings(pb.RequiredChecks) }</td>
							<td>{ pb.RequireReviews }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>

	<section class="mb-6">
		<h2 class="text-lg font-semibold mb-3">Labels</h2>
		<form method="post" action={ templ.SafeURL("/" + data.Nav.Owner + "/" + data.Nav.Repo + "/settings/label") } class="card p-4 mb-4 flex gap-3">
			@CSRFInput(data.CSRF)
			<input type="text" name="name" placeholder="Label name" required class="input flex-1"/>
			<input type="text" name="color" placeholder="#ff0000" class="input"/>
			<button type="submit" class="btn">Create label</button>
		</form>
		if len(data.Labels) == 0 {
			@EmptyState("No labels")
		} else {
			<div class="flex flex-wrap gap-2 mb-4">
				for _, l := range data.Labels {
					@LabelBadge(l.Name, l.Color)
				}
			</div>
		}
	</section>

	<section class="mb-6">
		<h2 class="text-lg font-semibold mb-3">Webhooks</h2>
		<form method="post" action={ templ.SafeURL("/" + data.Nav.Owner + "/" + data.Nav.Repo + "/settings/webhook") } class="card p-4 mb-4 flex flex-col gap-3">
			@CSRFInput(data.CSRF)
			<input type="url" name="url" placeholder="Payload URL" required class="input"/>
			<input type="text" name="events" placeholder="Events (comma-separated)" class="input"/>
			<button type="submit" class="btn self-start">Add webhook</button>
		</form>
		if len(data.Webhooks) == 0 {
			@EmptyState("No webhooks")
		} else {
			for _, wh := range data.Webhooks {
				<div class="card p-4 mb-4">
					<p class="font-medium m-0">{ wh.Hook.URL }</p>
					<p class="text-sm text-muted m-0 mt-1">{ wh.Hook.Events }</p>
					if len(wh.Deliveries) == 0 {
						<p class="text-sm text-muted mt-2 mb-0">No deliveries yet</p>
					} else {
						<table class="mt-3 w-full text-sm">
							<thead><tr><th>Event</th><th>Status</th><th>Time</th></tr></thead>
							<tbody>
								for _, d := range wh.Deliveries {
									<tr>
										<td>{ d.Event }</td>
										<td>{ d.StatusCode }</td>
										<td class="text-muted">{ d.DeliveredAt.Format("01-02 15:04") }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			}
		}
		</section>

		<section class="mb-6 border-2 border-red-500 rounded-lg p-4">
			<h2 class="text-lg font-semibold mb-3 text-red-600">Danger Zone</h2>
			<p class="text-sm text-muted mb-4">
				Once you delete a repository, its contents, issues, pull requests, and all associated data are permanently removed.
				This action <strong>cannot</strong> be undone. Please type the repository name to confirm.
			</p>
			<form method="post" action={ templ.SafeURL("/" + data.Nav.Owner + "/" + data.Nav.Repo + "/settings/delete") } class="flex gap-3 items-start" onsubmit="return confirm('Are you absolutely sure you want to delete this repository? This cannot be undone.')">
				@CSRFInput(data.CSRF)
				<input type="text" name="confirm" placeholder={ templ.SafeURL("type \"" + data.Nav.Repo + "\" to confirm") } required class="input flex-1"/>
				<button type="submit" class="btn bg-red-600 text-white hover:bg-red-700 font-bold">Delete this repository</button>
			</form>
		</section>
		</div>
	}

func joinStrings(ss []string) string {
	if len(ss) == 0 {
		return ""
	}
	out := ss[0]
	for i := 1; i < len(ss); i++ {
		out += ", " + ss[i]
	}
	return out
}
