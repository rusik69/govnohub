package web

import (
	"strconv"

	"github.com/rusik69/govnohub/internal/pull"
)

type PRDetailData struct {
	Header    RepoHeaderData
	Nav       RepoNavData
	PR        *pull.PullRequest
	Author    string
	Reviews   []pull.Review
	Comments  []pull.LineComment
	Files     []DiffFile
	CSRF      string
	Mergeable bool
}

templ PRDetailPage(layout LayoutData, data PRDetailData) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, Flash: layout.Flash, FlashErr: layout.FlashErr, FullWidth: true,
		Content: PRDetailContent(data),
	})
}

templ PRDetailContent(data PRDetailData) {
	@RepoPageShell(data.Header, data.Nav)
	<div class="max-w-7xl mx-auto">
		<div class="flex gap-4 max-md-flex-col">
			<div class="flex-1">
				<div class="flex items-center gap-2 mb-2">
					if data.PR.MergedAt != nil {
						@StateBadge("merged")
					} else {
						@StateBadge(data.PR.State)
					}
					<h1 class="gh-detail-title m-0">
						{ data.PR.Title } <span class="num">#{ data.PR.Number }</span>
					</h1>
				</div>
				<p class="text-sm text-muted mb-4">
					@Icon("git-pull-request", "")
					<span class="ml-2">{ data.PR.HeadBranch } → { data.PR.BaseBranch }</span>
				</p>
				if data.PR.Body != "" {
					<ul class="gh-timeline mb-4">
						@CommentBox(data.Author, "commented on this pull request", prBodyComponent(data.PR.Body))
					</ul>
				}
				for _, f := range data.Files {
					<div class="diff-file">
						<div class="diff-header">{ diffFilePath(f) }</div>
						for _, line := range f.Lines {
							@diffLineRow(data, f, line)
						}
					</div>
				}
			</div>
			<aside class="sidebar">
				if data.PR.State == "open" {
					<div class="gh-merge-box">
						<form method="post" action={ templ.SafeURL("/" + data.Nav.Owner + "/" + data.Nav.Repo + "/pulls/" + strconv.Itoa(data.PR.Number) + "/merge") }>
							@CSRFInput(data.CSRF)
							if data.Mergeable {
								<p class="text-sm m-0 mb-3">This branch has no conflicts with the base branch.</p>
								<button type="submit" class="btn w-full">
									@Icon("git-merge", "")
									Merge pull request
								</button>
							} else {
								<p class="text-sm m-0 mb-3 text-red">This branch has conflicts that must be resolved.</p>
								<button type="submit" class="btn w-full" disabled>Merge pull request</button>
							}
						</form>
					</div>
					<div class="gh-sidebar-panel mb-4">
						<div class="gh-sidebar-section">
							<div class="gh-sidebar-label">Review changes</div>
							<form method="post" action={ templ.SafeURL("/" + data.Nav.Owner + "/" + data.Nav.Repo + "/pulls/" + strconv.Itoa(data.PR.Number) + "/review") }>
								@CSRFInput(data.CSRF)
								<select name="state" class="input mb-2">
									<option value="approved">Approve</option>
									<option value="changes_requested">Request changes</option>
									<option value="commented">Comment</option>
								</select>
								@MarkdownTextarea("body", "Leave a review comment", "", data.CSRF)
								<button type="submit" class="btn-secondary w-full mt-2">Submit review</button>
							</form>
						</div>
					</div>
				}
				<div class="gh-sidebar-panel mb-4">
					<div class="gh-sidebar-section">
						<div class="gh-sidebar-label">Reviews</div>
						for _, r := range data.Reviews {
							<div class="text-sm mb-2"><strong>{ r.Reviewer }</strong>: { r.State }</div>
						}
						if len(data.Reviews) == 0 {
							<p class="text-sm text-muted m-0">No reviews yet</p>
						}
					</div>
				</div>
				<div class="gh-sidebar-panel" id="inline-comments">
					<div class="gh-sidebar-section">
						<div class="gh-sidebar-label">Inline comments</div>
						for _, c := range data.Comments {
							if c.Path != "" {
								<div class="text-sm mb-2 border-b pb-2">
									<strong>{ c.Author }</strong> on { c.Path }:{ strconv.Itoa(c.Line) }
									<p class="m-0 mt-1">{ c.Body }</p>
								</div>
							}
						}
						<form method="post" action={ templ.SafeURL("/" + data.Nav.Owner + "/" + data.Nav.Repo + "/pulls/" + strconv.Itoa(data.PR.Number) + "/comment") } class="mt-3">
							@CSRFInput(data.CSRF)
							<input type="hidden" name="path" id="comment-path"/>
							<input type="hidden" name="line" id="comment-line"/>
							@MarkdownTextarea("body", "Add inline comment (click or focus a line)", "", data.CSRF)
							<button type="submit" class="btn-secondary w-full mt-2">Add comment</button>
						</form>
					</div>
				</div>
			</aside>
		</div>
	</div>
	<script>
		function selectDiffLine(el) {
			document.querySelectorAll('.diff-line.selected').forEach(n => n.classList.remove('selected'));
			el.classList.add('selected');
			document.getElementById('comment-path').value = el.dataset.path;
			document.getElementById('comment-line').value = el.dataset.line;
		}
		document.querySelectorAll('.diff-line.clickable').forEach(el => {
			el.setAttribute('tabindex', '0');
			el.setAttribute('role', 'button');
			el.setAttribute('aria-label', 'Comment on line ' + el.dataset.line);
			el.addEventListener('click', () => selectDiffLine(el));
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					selectDiffLine(el);
				}
			});
		});
	</script>
}

templ prBodyComponent(body string) {
	<div class="markdown">@templ.Raw(issueBodyHTML(body))</div>
}

templ diffLineRow(data PRDetailData, f DiffFile, line DiffLine) {
	if line.Type == "hunk" {
		<div class="diff-line diff-hunk"><span class="code">{ line.Content }</span></div>
	} else if line.Type == "add" || line.Type == "del" {
		<div
			class={ "diff-line clickable " + diffLineClass(line.Type) }
			data-path={ diffFilePath(f) }
			data-line={ strconv.Itoa(lineNum(line)) }
		>
			<span class="num">{ lineNumStr(line.OldLine) }</span>
			<span class="num">{ lineNumStr(line.NewLine) }</span>
			<span class="code">{ diffPrefix(line.Type) }{ line.Content }</span>
		</div>
	} else {
		<div class={ "diff-line " + diffLineClass(line.Type) }>
			<span class="num">{ lineNumStr(line.OldLine) }</span>
			<span class="num">{ lineNumStr(line.NewLine) }</span>
			<span class="code"> { line.Content }</span>
		</div>
	}
}

func diffFilePath(f DiffFile) string {
	if f.NewPath != "" {
		return f.NewPath
	}
	return f.OldPath
}

func diffLineClass(t string) string {
	switch t {
	case "add":
		return "diff-add"
	case "del":
		return "diff-del"
	default:
		return ""
	}
}

func diffPrefix(t string) string {
	if t == "add" {
		return "+"
	}
	if t == "del" {
		return "-"
	}
	return ""
}

func lineNum(line DiffLine) int {
	if line.NewLine > 0 {
		return line.NewLine
	}
	return line.OldLine
}

func lineNumStr(n int) string {
	if n <= 0 {
		return ""
	}
	return strconv.Itoa(n)
}
