package web

import (
	"fmt"
	"strconv"
	"strings"

	gitstore "github.com/rusik69/govnohub/internal/git"
	"github.com/rusik69/govnohub/internal/issue"
	"github.com/rusik69/govnohub/internal/pull"
	"github.com/rusik69/govnohub/internal/repo"
)

type RepoNavData struct {
	Owner      string
	Repo       string
	Tab        string
	FullName   string
	IssueCount int
	PullCount  int
}

type RepoHeaderData struct {
	Repository *repo.Repository
	CSRF       string
	Starred    bool
	Watched    bool
	CloneHTTPS string
	CloneSSH   string
}

type RepoBranchOption struct {
	Name string
}

templ Icon(name string, class string) {
	<svg class={ "gh-icon " + class } aria-hidden="true">
		<use href={ templ.SafeURL("/static/icons.svg#" + name) }></use>
	</svg>
}

templ Avatar(username string, size string) {
	<span class={ avatarClass(size) } style={ "background:" + avatarColor(username) }>{ avatarInitial(username) }</span>
}

func avatarClass(size string) string {
	if size == "lg" {
		return "gh-avatar gh-avatar-lg"
	}
	return "gh-avatar"
}

func avatarInitial(username string) string {
	if username == "" {
		return "?"
	}
	return strings.ToUpper(username[:1])
}

func avatarColor(name string) string {
	colors := []string{"#bf3989", "#0969da", "#1a7f37", "#8250df", "#fb8500", "#cf222e", "#0550ae", "#6639ba"}
	h := 0
	for _, c := range name {
		h += int(c)
	}
	return colors[h%len(colors)]
}

templ RepoPageShell(header RepoHeaderData, nav RepoNavData) {
	<div class="max-w-7xl mx-auto">
		@RepoHeader(header)
		@RepoNav(nav)
	</div>
}

templ PageHeader(title string, actions templ.Component) {
	<div class="flex justify-between items-center mb-6 gap-3 flex-wrap">
		<h1 class="text-2xl font-bold m-0">{ title }</h1>
		if actions != nil {
			<div class="flex gap-2 flex-wrap">
				@actions
			</div>
		}
	</div>
}

templ CollapsibleForm(title string, content templ.Component) {
	<details class="collapsible-form card mb-4">
		<summary class="collapsible-form-summary">{ title }</summary>
		<div class="collapsible-form-body p-4">
			@content
		</div>
	</details>
}

templ FormField(label, id, inputType, name, value string, required bool) {
	<div class="form-field">
		<label class="text-sm" for={ id }>{ label }</label>
		if inputType == "textarea" {
			<textarea id={ id } name={ name } class="input mt-2" rows="3">{ value }</textarea>
		} else {
			<input type={ inputType } id={ id } name={ name } value={ value } class="input mt-2" required?={ required }/>
		}
	</div>
}

templ Toast(message, variant string) {
	<div class={ "toast toast-" + variant } role="status" aria-live="polite">{ message }</div>
}

templ RepoHeader(data RepoHeaderData) {
	<div class="gh-repo-band">
		<div class="gh-repo-head">
			<div>
				<h1 class="gh-repo-title">
					<a href={ templ.SafeURL("/" + data.Repository.OwnerName) } class="owner">{ data.Repository.OwnerName }</a>
					<span class="sep">/</span>
					<a href={ templ.SafeURL("/" + data.Repository.FullName) } class="repo-name">{ data.Repository.Name }</a>
				</h1>
				<div class="gh-repo-meta">
					if data.Repository.Description != "" {
						<span>{ data.Repository.Description }</span>
					}
					<span class="gh-visibility">
						if data.Repository.IsPrivate {
							Private
						} else {
							Public
						}
					</span>
					if data.Repository.IsFork {
						<span class="gh-visibility">Fork</span>
					}
					<a href={ templ.SafeURL("/" + data.Repository.FullName + "/actions") } class="inline-flex items-center ml-2 align-middle" title="CI status">
						<img
							src={ templ.SafeURL("/" + data.Repository.FullName + "/actions/badge.svg") }
							alt="CI status"
							height="20"
							loading="lazy"
						/>
					</a>
				</div>
			</div>
			<div class="gh-repo-actions">
				<div class="gh-btn-group">
				if data.Starred {
					<form method="post" action={ templ.SafeURL("/" + data.Repository.FullName + "/unstar") }>
						@CSRFInput(data.CSRF)
						<button type="submit" class="gh-btn-seg">
							@Icon("star", "")
							Starred
							<span class="gh-counter">{ strconv.Itoa(data.Repository.StarCount) }</span>
						</button>
					</form>
				} else {
					<form method="post" action={ templ.SafeURL("/" + data.Repository.FullName + "/star") }>
						@CSRFInput(data.CSRF)
						<button type="submit" class="gh-btn-seg">
							@Icon("star", "")
							Star
							<span class="gh-counter">{ strconv.Itoa(data.Repository.StarCount) }</span>
						</button>
					</form>
				}
				if data.Watched {
					<form method="post" action={ templ.SafeURL("/" + data.Repository.FullName + "/unwatch") }>
						@CSRFInput(data.CSRF)
						<button type="submit" class="gh-btn-seg">
							@Icon("eye", "")
							Unwatch
						</button>
					</form>
				} else {
					<form method="post" action={ templ.SafeURL("/" + data.Repository.FullName + "/watch") }>
						@CSRFInput(data.CSRF)
						<button type="submit" class="gh-btn-seg">
							@Icon("eye", "")
							Watch
						</button>
					</form>
				}
				<button
					type="button"
					class="gh-btn-seg"
					hx-get={ templ.SafeURL("/" + data.Repository.FullName + "/fork/dialog") }
					hx-target="#fork-dialog-container"
					hx-swap="innerHTML"
					hx-trigger="click"
					hx-indicator="#fork-loading"
				>
					@Icon("repo-forked", "")
					Fork
				</button>
				<div id="fork-loading" class="htmx-indicator" style="display:inline-flex;align-items:center;gap:0.25rem">
					@LoadingSpinnerSmall()
					<span class="text-xs text-muted">Loading...</span>
				</div>
				</div>
				@CloneDropdown(data.CloneHTTPS, data.CloneSSH)
			</div>
		</div>
	</div>
}

templ CloneDropdown(httpsURL, sshURL string) {
	<details class="gh-clone-menu">
		<summary class="gh-clone-btn">
			@Icon("code", "")
			Code
		</summary>
		<div class="gh-clone-panel card">
			<div class="gh-clone-tabs" role="tablist">
				<button type="button" class="active" data-clone-tab="https" role="tab" aria-selected="true" onclick="switchCloneTab(this,'https')">HTTPS</button>
				<button type="button" data-clone-tab="ssh" role="tab" aria-selected="false" onclick="switchCloneTab(this,'ssh')">SSH</button>
			</div>
			<p class="gh-clone-label text-sm m-0 mb-2">Clone</p>
			<div class="gh-clone-url-row">
				<input type="text" class="input gh-clone-url" readonly value={ httpsURL } data-https={ httpsURL } data-ssh={ sshURL } aria-label="Clone URL"/>
				<button type="button" class="gh-clone-copy gh-header-btn" aria-label="Copy" onclick="copyCloneUrl(this)">
					@Icon("copy", "")
				</button>
			</div>
			<p
				class="gh-clone-hint text-sm text-muted m-0 mt-2"
				data-https-hint="Use a personal access token from Settings for HTTPS auth."
				data-ssh-hint="Use a password-protected SSH key from Settings."
			>Use a personal access token from Settings for HTTPS auth.</p>
		</div>
	</details>
}

templ RepoNav(data RepoNavData) {
	<nav class="gh-tab-nav">
		@repoTab(data, "code", "/", "code", "Code", 0)
		@repoTab(data, "issues", "/issues", "issue-opened", "Issues", data.IssueCount)
		@repoTab(data, "pulls", "/pulls", "git-pull-request", "Pull requests", data.PullCount)
		@repoTab(data, "milestones", "/milestones", "milestone", "Milestones", 0)
		@repoTab(data, "tags", "/tags", "tag", "Tags", 0)
		@repoTab(data, "actions", "/actions", "play", "Actions", 0)
		@repoTab(data, "releases", "/releases", "tag", "Releases", 0)
		@repoTab(data, "packages", "/packages", "package", "Packages", 0)
		@repoTab(data, "wiki", "/wiki", "book", "Wiki", 0)
		@repoTab(data, "settings", "/settings", "gear", "Settings", 0)
	</nav>
}

templ repoTab(data RepoNavData, tab, suffix, icon, title string, count int) {
	<a href={ templ.SafeURL("/" + data.Owner + "/" + data.Repo + suffix) } class={ tabClass(data.Tab, tab) } aria-current={ tabAriaCurrent(data.Tab, tab) }>
		@Icon(iconName(icon, tab), "")
		{ title }
		if count > 0 && (tab == "issues" || tab == "pulls") {
			<span class="gh-counter">{ strconv.Itoa(count) }</span>
		}
	</a>
}

func tabAriaCurrent(active, tab string) string {
	if active == tab {
		return "page"
	}
	return ""
}

func iconName(icon, tab string) string {
	if icon != "" {
		return icon
	}
	return tab
}

func tabClass(active, tab string) string {
	if active == tab {
		return "active"
	}
	return ""
}

templ IssueSubhead(nav RepoNavData, state string, openCount, closedCount int) {
	<div class="gh-subhead">
		<a href={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/issues") } class={ subheadPillClass(state, "open") } aria-current={ subheadAriaCurrent(state, "open") }>
			@Icon("issue-opened", "")
			{ strconv.Itoa(openCount) } Open
		</a>
		<a href={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/issues?state=closed") } class={ subheadPillClass(state, "closed") } aria-current={ subheadAriaCurrent(state, "closed") }>
			@Icon("issue-closed", "")
			{ strconv.Itoa(closedCount) } Closed
		</a>
	</div>
}

templ PRSubhead(nav RepoNavData, prs []pull.PullRequest, state string) {
	<div class="gh-subhead">
		<a href={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/pulls") } class={ subheadPillClass(state, "open") } aria-current={ subheadAriaCurrent(state, "open") }>
			@Icon("git-pull-request", "")
			{ strconv.Itoa(countPRsByState(prs, "open")) } Open
		</a>
		<a href={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/pulls?state=closed") } class={ subheadPillClass(state, "closed") } aria-current={ subheadAriaCurrent(state, "closed") }>
			@Icon("git-pull-request", "")
			{ strconv.Itoa(countPRsByState(prs, "closed")) } Closed
		</a>
	</div>
}

func subheadPillClass(current, pill string) string {
	if current == pill || (current == "" && pill == "open") {
		return "gh-subhead-pill active"
	}
	return "gh-subhead-pill"
}

func subheadAriaCurrent(current, pill string) string {
	if current == pill || (current == "" && pill == "open") {
		return "page"
	}
	return ""
}

func countIssuesByState(issues []issue.Issue, state string) int {
	n := 0
	for _, i := range issues {
		if i.State == state {
			n++
		}
	}
	return n
}

func countPRsByState(prs []pull.PullRequest, state string) int {
	n := 0
	for _, pr := range prs {
		if pr.State == state {
			n++
		}
	}
	return n
}

templ IssueListItem(nav RepoNavData, i issue.Issue) {
	<a href={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/issues/" + strconv.Itoa(i.Number)) } class="gh-list-item">
		<span class={ "gh-list-item-icon " + issueIconClass(i.State) }>
			if i.State == "open" {
				@Icon("issue-opened", "")
			} else {
				@Icon("issue-closed", "")
			}
		</span>
		<div class="gh-list-item-body">
			<div class="gh-list-item-title">{ i.Title }</div>
			<div class="gh-list-item-meta">
				#{ strconv.Itoa(i.Number) }
				if i.Author != "" {
					<span> opened by { i.Author }</span>
				}
			</div>
		</div>
	</a>
}

func issueIconClass(state string) string {
	if state == "open" {
		return "open"
	}
	return "closed"
}

templ PRListItem(nav RepoNavData, pr pull.PullRequest) {
	<a href={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/pulls/" + strconv.Itoa(pr.Number)) } class="gh-list-item">
		<span class={ "gh-list-item-icon " + prIconClass(pr) }>
			@Icon(prIconName(pr), "")
		</span>
		<div class="gh-list-item-body">
			<div class="gh-list-item-title">{ pr.Title }</div>
			<div class="gh-list-item-meta">
				#{ strconv.Itoa(pr.Number) } · { pr.HeadBranch } → { pr.BaseBranch }
			</div>
		</div>
	</a>
}

func prIconClass(pr pull.PullRequest) string {
	if pr.State == "open" {
		return "open"
	}
	if pr.MergedAt != nil {
		return "closed"
	}
	return "closed"
}

func prIconName(pr pull.PullRequest) string {
	if pr.MergedAt != nil {
		return "git-merge"
	}
	return "git-pull-request"
}

templ BranchBar(fullName, ref, path string, branches []RepoBranchOption) {
	<div class="gh-branch-bar">
		<label class="sr-only" for="branch-select">Branch</label>
		<select
			id="branch-select"
			class="gh-branch-selector input"
			onchange="(function(s){var u=new URL(window.location.href);u.searchParams.set('ref',s.value);window.location=u})(this)"
		>
			for _, b := range branches {
				<option value={ b.Name } selected?={ b.Name == ref }>{ b.Name }</option>
			}
			if len(branches) == 0 {
				<option value={ ref } selected>{ ref }</option>
			}
		</select>
		if path != "" {
			<span class="gh-breadcrumb">
				<a href={ templ.SafeURL("/" + fullName + "?ref=" + ref) }>{ fullName }</a>
				<span> / </span>
				{ path }
			</span>
		}
	</div>
}

templ FileTable(fullName, ref, basePath string, entries []gitstore.TreeEntry) {
	<div class="gh-file-table">
		for _, e := range entries {
			<div class="gh-file-row">
				if e.Type == "dir" {
					@Icon("file-directory", "")
				} else {
					@Icon("file", "")
				}
				<a href={ templ.SafeURL(repoEntryURL(fullName, ref, basePath, e)) }>{ e.Path }</a>
			</div>
		}
	</div>
}

templ CommentBox(author, action string, body templ.Component) {
	<li class="gh-timeline-item">
		<div class="gh-timeline-rail">
			@Avatar(author, "")
		</div>
		<div class="gh-timeline-body">
			<div class="gh-timeline-header">
				<strong>{ author }</strong> { action }
			</div>
			<div class="gh-timeline-content">
				@body
			</div>
		</div>
	</li>
}

templ StateBadge(state string) {
	if state == "open" {
		<span class="gh-state gh-state-open">
			@Icon("issue-opened", "")
			Open
		</span>
	} else if state == "merged" {
		<span class="gh-state gh-state-merged">
			@Icon("git-merge", "")
			Merged
		</span>
	} else {
		<span class="gh-state gh-state-closed">
			@Icon("issue-closed", "")
			Closed
		</span>
	}
}

templ LabelBadge(name, color string) {
	<span class="gh-label" style={ "background:" + labelColor(color) + ";color:" + labelTextColor(color) }>{ name }</span>
}

func labelColor(color string) string {
	if color == "" {
		return "#656d76"
	}
	if color[0] != '#' {
		color = "#" + color
	}
	return color
}

func labelTextColor(color string) string {
	c := labelColor(color)
	if len(c) != 7 {
		return "#fff"
	}
	var r, g, b int
	fmt.Sscanf(c[1:], "%02x%02x%02x", &r, &g, &b)
	luminance := (0.299*float64(r) + 0.587*float64(g) + 0.114*float64(b)) / 255
	if luminance > 0.6 {
		return "#1f2328"
	}
	return "#fff"
}

templ CSRFInput(token string) {
	<input type="hidden" name="csrf_token" value={ token }/>
}

templ ErrorAlert(msg string) {
	if msg != "" {
		<div class="alert alert-error">{ msg }</div>
	}
}

templ EmptyState(msg string) {
	<p class="text-muted text-center py-4">{ msg }</p>
}

templ SkeletonLine() {
	<div class="gh-skeleton gh-skeleton-text"></div>
}

templ SkeletonLines(count int) {
	for i := 0; i < count; i++ {
		<div class="gh-skeleton gh-skeleton-text"></div>
	}
}

templ SkeletonTitle() {
	<div class="gh-skeleton gh-skeleton-title"></div>
}

templ SkeletonAvatar() {
	<div class="gh-skeleton gh-skeleton-avatar"></div>
}

templ SkeletonAvatarSmall() {
	<div class="gh-skeleton gh-skeleton-avatar-sm"></div>
}

templ SkeletonButton() {
	<div class="gh-skeleton gh-skeleton-button"></div>
}

templ SkeletonCard(children ...templ.Component) {
	<div class="gh-skeleton-card">
		for _, child := range children {
			@child
		}
	</div>
}

templ SkeletonListItem(hasTitle bool) {
	<div class="gh-skeleton-list-item">
		<div class={ skeletonAvatarClass(hasTitle) }></div>
		<div style="flex:1; min-width:0">
			<div class="gh-skeleton gh-skeleton-text" style="width:65%"></div>
			<div class="gh-skeleton gh-skeleton-text" style="width:40%"></div>
		</div>
	</div>
}

func skeletonAvatarClass(isTitle bool) string {
	if isTitle {
		return "gh-skeleton gh-skeleton-avatar-sm"
	}
	return "gh-skeleton gh-skeleton-avatar"
}

templ SkeletonIssueList(count int) {
	<div class="gh-list">
		for i := 0; i < count; i++ {
			@SkeletonListItem(true)
		}
	</div>
}

templ LoadingSpinner() {
	<span class="gh-spinner" role="status" aria-label="Loading"></span>
}

templ LoadingSpinnerLarge() {
	<span class="gh-spinner gh-spinner-lg" role="status" aria-label="Loading"></span>
}

templ LoadingSpinnerSmall() {
	<span class="gh-spinner gh-spinner-sm" role="status" aria-label="Loading"></span>
}

templ HXIndicator(id string) {
	<div id={ id } class="htmx-indicator flex items-center justify-center py-4">
		@LoadingSpinnerLarge()
		<span class="text-muted text-sm ml-2">Loading...</span>
	</div>
}

templ SkeletonTable(count int) {
	<div style="padding:1rem">
		for i := 0; i < count; i++ {
			<div class="flex items-center gap-2" style="padding:0.5rem 0">
				<div class="gh-skeleton gh-skeleton-text" style="flex:2"></div>
				<div class="gh-skeleton gh-skeleton-text" style="flex:1"></div>
				<div class="gh-skeleton gh-skeleton-text" style="flex:1"></div>
			</div>
			if i < count-1 {
				<div class="gh-skeleton-line"></div>
			}
		}
	</div>
}

templ MarkdownTextarea(name, placeholder, value, csrf string) {
	<div class="md-preview-container" data-md-container="true">
		<div class="md-tabs" data-md-tabs="true">
			<button type="button" class="md-tab active" data-md-tab="write">Write</button>
			<button type="button" class="md-tab" data-md-tab="preview" data-csrf={ csrf }>Preview</button>
		</div>
		<div class="md-write" data-md-write="true">
			<textarea name={ name } class="input" rows="4" placeholder={ placeholder } data-mention-enabled="true" data-emoji-enabled="true">{ value }</textarea>
		</div>
		<div class="md-preview-content markdown" data-md-preview="true" style="display:none"></div>
	</div>
}
