package web

import "github.com/rusik69/govnohub/internal/search"

templ SearchPage(layout LayoutData, query string, hits []search.Hit) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, Flash: layout.Flash, FlashErr: layout.FlashErr, ActiveNav: "search",
		Content: SearchContent(query, hits),
	})
}

templ SearchContent(query string, hits []search.Hit) {
	@PageHeader("Search", templ.NopComponent)
	<form method="get" action="/search" class="mb-6 flex gap-2 flex-wrap items-center">
		<input type="search" name="q" value={ query } placeholder="Search repos, issues, pull requests..." class="input max-w-3xl flex-1" autofocus?={ query == "" }/>
		<button type="submit" class="btn">Search</button>
	</form>
	if query == "" {
		@EmptyState("Enter a search query to find repositories, issues, and pull requests")
	} else if len(hits) == 0 {
		@EmptyState("No results found for \"" + query + "\"")
	} else {
		<div class="gh-list">
			for _, h := range hits {
				<a href={ templ.SafeURL(searchHitURL(h)) } class="gh-list-item">
					<span class="gh-list-item-icon">
						@Icon(searchHitIcon(h.Type), "")
					</span>
					<div class="gh-list-item-body">
						<div class="gh-list-item-title">{ h.Title }</div>
						<div class="gh-list-item-meta">
							<span class="badge">{ h.Type }</span>
							if h.Repo != "" {
								<span> · { h.Repo }</span>
							}
						</div>
						if h.Snippet != "" {
							<p class="text-sm m-0 mt-1">{ h.Snippet }</p>
						}
					</div>
				</a>
			}
		</div>
	}
}

func searchHitIcon(typ string) string {
	switch typ {
	case "issue":
		return "issue-opened"
	case "pull_request":
		return "git-pull-request"
	default:
		return "repo"
	}
}

func searchHitURL(h search.Hit) string {
	if h.Type == "repo" && h.Repo != "" {
		return "/" + h.Repo
	}
	if h.Type == "issue" && h.Repo != "" && h.Ref != "" {
		return "/" + h.Repo + "/issues/" + h.Ref
	}
	if h.Type == "pull_request" && h.Repo != "" && h.Ref != "" {
		return "/" + h.Repo + "/pulls/" + h.Ref
	}
	return "/search?q=" + h.Title
}
