package web

import "github.com/rusik69/govnohub/internal/auth"

templ AdminUsersPage(layout LayoutData, users []auth.User, errMsg string) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, Content: AdminUsersContent(layout.CSRF, users, errMsg),
	})
}

templ AdminUsersContent(csrf string, users []auth.User, errMsg string) {
	@PageHeader("Admin · Users", templ.NopComponent)
	<p class="mb-4"><a href="/admin/audit">Audit log</a></p>
	@ErrorAlert(errMsg)
	@CollapsibleForm("Create user", AdminUserCreateForm(csrf))
	<div class="overflow-auto">
		<table class="card">
			<thead><tr><th scope="col">Username</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Created</th><th scope="col"></th></tr></thead>
		<tbody>
			for _, u := range users {
				<tr>
					<td>{ u.Username }</td>
					<td>{ u.Email }</td>
					<td>{ u.Role }</td>
					<td class="text-sm text-muted">{ u.CreatedAt.Format("2006-01-02") }</td>
					<td>
						<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID.String() + "/delete") }>
							@CSRFInput(csrf)
							<button type="submit" class="btn-secondary text-sm">Delete</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
		</table>
	</div>
}

templ AdminUserCreateForm(csrf string) {
	<form method="post" action="/admin/users" class="grid grid-cols-2 gap-4">
		@CSRFInput(csrf)
		@FormField("Username", "admin-username", "text", "username", "", true)
		@FormField("Email", "admin-email", "email", "email", "", true)
		@FormField("Password", "admin-password", "password", "password", "", true)
		<div class="form-field">
			<label class="text-sm" for="admin-role">Role</label>
			<select id="admin-role" name="role" class="input mt-2">
				<option value="user">user</option>
				<option value="admin">admin</option>
			</select>
		</div>
		<div class="col-span-2"><button type="submit" class="btn">Create user</button></div>
	</form>
}
