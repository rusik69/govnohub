package web

import "github.com/rusik69/govnohub/internal/auth"

templ AdminUsersPage(layout LayoutData, users []auth.User, errMsg string) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, Content: AdminUsersContent(layout.CSRF, users, errMsg),
	})
}

templ AdminUsersContent(csrf string, users []auth.User, errMsg string) {
	<h1 class="text-2xl font-bold mb-6">Admin · Users</h1>
	@ErrorAlert(errMsg)
	<form method="post" action="/admin/users" class="card p-4 mb-6 grid grid-cols-2 gap-4">
		@CSRFInput(csrf)
		<div><label class="text-sm">Username</label><input name="username" required class="input mt-2"/></div>
		<div><label class="text-sm">Email</label><input name="email" type="email" required class="input mt-2"/></div>
		<div><label class="text-sm">Password</label><input name="password" type="password" required class="input mt-2"/></div>
		<div><label class="text-sm">Role</label>
			<select name="role" class="input mt-2"><option value="user">user</option><option value="admin">admin</option></select>
		</div>
		<div class="col-span-2"><button type="submit" class="btn">Create user</button></div>
	</form>
	<table class="card">
		<thead><tr><th>Username</th><th>Email</th><th>Role</th><th>Created</th><th></th></tr></thead>
		<tbody>
			for _, u := range users {
				<tr>
					<td>{ u.Username }</td>
					<td>{ u.Email }</td>
					<td>{ u.Role }</td>
					<td class="text-sm text-muted">{ u.CreatedAt.Format("2006-01-02") }</td>
					<td>
						<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID.String() + "/delete") }>
							@CSRFInput(csrf)
							<button type="submit" class="btn-secondary text-sm">Delete</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
