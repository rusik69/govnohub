package web

import "time"

type WorkflowInfo struct {
	ID     string
	Name   string
	Path   string
	Active bool
}

type WorkflowRun struct {
	ID         string
	RunNumber  int
	Event      string
	HeadBranch string
	Status     string
	Conclusion string
	CreatedAt  time.Time
}

templ ActionsPage(layout LayoutData, header RepoHeaderData, nav RepoNavData, workflows []WorkflowInfo, runs []WorkflowRun, csrf string) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, FullWidth: true,
		Content: ActionsContent(header, nav, workflows, runs, csrf),
	})
}

templ ActionsContent(header RepoHeaderData, nav RepoNavData, workflows []WorkflowInfo, runs []WorkflowRun, csrf string) {
	@RepoPageShell(header, nav)
	<div class="max-w-7xl mx-auto">
		<h1 class="text-xl font-bold mb-4">Actions</h1>
		if len(workflows) > 0 {
			<div class="card p-4 mb-6">
				<h2 class="text-sm font-semibold mb-3 m-0">Workflows</h2>
				<div class="flex flex-col gap-3">
					for _, wf := range workflows {
						<div class="flex justify-between items-center gap-3 flex-wrap">
							<div>
								<div class="font-medium">{ wf.Name }</div>
								<div class="text-xs text-muted">{ wf.Path }</div>
							</div>
							<form method="post" action={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/actions/trigger") } class="flex gap-2 items-center">
								@CSRFInput(csrf)
								<input type="hidden" name="workflow_id" value={ wf.ID }/>
								<input type="text" name="branch" value="main" class="input text-sm" style="width:8rem" aria-label="Branch to run"/>
								<button type="submit" class="btn-secondary text-sm">Run workflow</button>
							</form>
						</div>
					}
				</div>
			</div>
		}
		if len(runs) == 0 {
			@EmptyState("No workflow runs")
		} else {
			<div class="overflow-auto">
				<table class="card">
					<thead><tr><th scope="col">Run</th><th scope="col">Event</th><th scope="col">Branch</th><th scope="col">Status</th><th scope="col">Logs</th></tr></thead>
					<tbody>
						for _, run := range runs {
							<tr>
								<td>#{ run.RunNumber }</td>
								<td>{ run.Event }</td>
								<td>{ run.HeadBranch }</td>
								<td>@RunStatusBadge(run)</td>
								<td>
									<button
										type="button"
										class="btn-secondary text-xs"
										hx-get={ "/" + nav.Owner + "/" + nav.Repo + "/actions/runs/" + run.ID + "/logs" }
										hx-target={ "#logs-" + run.ID }
										hx-swap="innerHTML"
									>
										Show logs
									</button>
								</td>
							</tr>
							<tr>
								<td colspan="5" class="p-0 border-0">
									<div id={ "logs-" + run.ID } class="p-3"></div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ RunStatusBadge(run WorkflowRun) {
	if run.Conclusion == "success" {
		<span class="gh-state gh-state-open">{ runStatusLabel(run) }</span>
	} else if run.Conclusion == "failure" {
		<span class="gh-state gh-state-closed">{ runStatusLabel(run) }</span>
	} else {
		<span class="badge">{ runStatusLabel(run) }</span>
	}
}

templ ActionLogsPartial(logs string, logURL string) {
	<pre
		class="m-0 p-3 bg-hover rounded text-xs overflow-auto max-h-64"
		hx-get={ logURL }
		hx-trigger="every 2s"
		hx-swap="outerHTML"
	>{ logs }</pre>
}

func runStatusLabel(run WorkflowRun) string {
	if run.Conclusion != "" {
		return run.Conclusion
	}
	return run.Status
}
