package web

import (
	"strconv"

	"github.com/rusik69/govnohub/internal/release"
)

type ReleaseWithAssets struct {
	Release release.Release
	Assets  []release.Asset
}

templ ReleasesPage(layout LayoutData, header RepoHeaderData, nav RepoNavData, releases []ReleaseWithAssets, csrf string) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, Flash: layout.Flash, FlashErr: layout.FlashErr, FullWidth: true,
		Content: ReleasesContent(header, nav, releases, csrf),
	})
}

templ ReleasesContent(header RepoHeaderData, nav RepoNavData, releases []ReleaseWithAssets, csrf string) {
	@RepoPageShell(header, nav)
	<div class="max-w-7xl mx-auto">
		<h1 class="text-xl font-bold mb-4">Releases</h1>
		@CollapsibleForm("Create release", ReleaseCreateForm(nav, csrf))
		if len(releases) == 0 {
			@EmptyState("No releases")
		} else {
			for _, row := range releases {
				<div class="card p-4 mb-4">
					<strong>{ row.Release.TagName }</strong>
					if row.Release.Name != "" {
						<span class="ml-2">{ row.Release.Name }</span>
					}
					<p class="text-sm text-muted m-0 mt-1"><time datetime={ timeAttr(row.Release.CreatedAt) } title={ timeTooltip(row.Release.CreatedAt) }>{ relativeTime(row.Release.CreatedAt) }</time></p>
					if row.Release.Body != "" {
						<div class="markdown mt-3 mb-0 text-sm">{ row.Release.Body }</div>
					}
					if len(row.Assets) > 0 {
						<ul class="mt-3 mb-0">
							for _, a := range row.Assets {
								<li class="text-sm">
									<a href={ templ.SafeURL("/api/v1/repos/" + nav.Owner + "/" + nav.Repo + "/releases/" + row.Release.TagName + "/assets/" + a.Name) }>{ a.Name }</a>
									<span class="text-muted ml-2">({ strconv.FormatInt(a.SizeBytes, 10) } bytes)</span>
								</li>
							}
						</ul>
					}
					<form method="post" action={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/releases/" + row.Release.TagName + "/assets") } enctype="multipart/form-data" class="mt-3 flex gap-2 items-center flex-wrap">
						@CSRFInput(csrf)
						<input type="file" name="file" required class="input flex-1"/>
						<button type="submit" class="btn-secondary">Upload asset</button>
					</form>
				</div>
			}
		}
	</div>
}

templ ReleaseCreateForm(nav RepoNavData, csrf string) {
	<form method="post" action={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/releases") } class="grid grid-cols-2 gap-3">
		@CSRFInput(csrf)
		<input type="text" name="tag" placeholder="Tag" required class="input"/>
		<input type="text" name="name" placeholder="Release name" class="input"/>
		<textarea name="body" placeholder="Release notes" class="input col-span-2" rows="3"></textarea>
		<button type="submit" class="btn col-span-2">Create release</button>
	</form>
}
