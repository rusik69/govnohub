package web

import (
	"strconv"

	"github.com/google/uuid"
	"github.com/rusik69/govnohub/internal/issue"
)

templ IssueDetailPage(layout LayoutData, header RepoHeaderData, nav RepoNavData, iss *issue.Issue, comments []issue.Comment, labels []issue.Label, milestones []issue.Milestone, users []string, csrf string) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, Flash: layout.Flash, FlashErr: layout.FlashErr, FullWidth: true,
		Content: IssueDetailContent(header, nav, iss, comments, labels, milestones, users, csrf),
	})
}

templ IssueDetailContent(header RepoHeaderData, nav RepoNavData, iss *issue.Issue, comments []issue.Comment, labels []issue.Label, milestones []issue.Milestone, users []string, csrf string) {
	@RepoPageShell(header, nav)
	<div class="max-w-7xl mx-auto">
		<div class="flex gap-4 max-md-flex-col">
			<div class="flex-1">
				<div class="flex items-center gap-2 mb-3">
					@StateBadge(iss.State)
					<h1 class="gh-detail-title m-0">
						{ iss.Title } <span class="num">#{ iss.Number }</span>
					</h1>
				</div>
				<ul class="gh-timeline">
					@CommentBox(iss.Author, "opened this issue", issueBodyComponent(iss.Body))
					for _, c := range comments {
						@CommentBox(c.Author, "commented", issueBodyComponent(c.Body))
					}
				</ul>
				<form method="post" action={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/issues/" + strconv.Itoa(iss.Number) + "/comment") } class="mt-4">
					@CSRFInput(csrf)
					@MarkdownTextarea("body", "Leave a comment", "", csrf)
					<button type="submit" class="btn mt-2">Comment</button>
				</form>
			</div>
			<aside class="sidebar">
				<div id="issue-toast"></div>
				<div class="gh-sidebar-panel">
					<div class="gh-sidebar-section">
						<div class="gh-sidebar-label">Assignees</div>
						<form hx-post={ "/" + nav.Owner + "/" + nav.Repo + "/issues/" + strconv.Itoa(iss.Number) + "/assignee" } hx-target="#issue-toast" hx-swap="innerHTML" hx-indicator="#assignee-indicator">
							@CSRFInput(csrf)
							<select name="assignee" class="input" onchange="this.form.requestSubmit()">
								<option value="">No one assigned</option>
								for _, u := range users {
									<option value={ u } selected?={ iss.Assignee == u }>{ u }</option>
								}
							</select>
							@LoadingSpinnerSmall()
							<span id="assignee-indicator" class="htmx-indicator text-xs text-muted">Updating...</span>
						</form>
					</div>
					<div class="gh-sidebar-section">
						<div class="gh-sidebar-label">Milestone</div>
						<form hx-post={ "/" + nav.Owner + "/" + nav.Repo + "/issues/" + strconv.Itoa(iss.Number) + "/milestone" } hx-target="#issue-toast" hx-swap="innerHTML" hx-indicator="#milestone-indicator">
							@CSRFInput(csrf)
							<select name="milestone_id" class="input" onchange="this.form.requestSubmit()">
								<option value="">No milestone</option>
								for _, m := range milestones {
									<option value={ m.ID.String() } selected?={ iss.MilestoneID != nil && iss.MilestoneID.String() == m.ID.String() }>{ m.Title }</option>
								}
							</select>
							@LoadingSpinnerSmall()
							<span id="milestone-indicator" class="htmx-indicator text-xs text-muted">Updating...</span>
						</form>
					</div>
					<div class="gh-sidebar-section">
						<div class="gh-sidebar-label">Labels</div>
						<div class="flex flex-wrap gap-2 mb-3">
							for _, l := range iss.Labels {
								<span class="inline-flex items-center gap-1">
									@LabelBadge(l.Name, l.Color)
									<form method="post" action={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/issues/" + strconv.Itoa(iss.Number) + "/labels/" + l.ID.String() + "/remove") } class="inline">
										@CSRFInput(csrf)
										<button type="submit" class="btn-secondary text-xs" aria-label={ "Remove label " + l.Name }>×</button>
									</form>
								</span>
							}
						</div>
						for _, l := range labels {
							if !issueHasLabel(iss, l.ID) {
								<form method="post" action={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/issues/" + strconv.Itoa(iss.Number) + "/labels/" + l.ID.String()) } class="inline mr-2">
									@CSRFInput(csrf)
									<button type="submit" class="btn-secondary text-xs">+ { l.Name }</button>
								</form>
							}
						}
					</div>
					if iss.State == "open" {
						<div class="gh-sidebar-section">
							<form method="post" action={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/issues/" + strconv.Itoa(iss.Number) + "/close") }>
								@CSRFInput(csrf)
								<button type="submit" class="btn-secondary w-full">Close issue</button>
							</form>
						</div>
					}
				</div>
			</aside>
		</div>
	</div>
}

func issueHasLabel(iss *issue.Issue, id uuid.UUID) bool {
	for _, l := range iss.Labels {
		if l.ID == id {
			return true
		}
	}
	return false
}

templ issueBodyComponent(body string) {
	<div class="markdown">@templ.Raw(issueBodyHTML(body))</div>
}

func issueBodyHTML(body string) string {
	html, err := RenderMarkdown(body)
	if err != nil {
		return body
	}
	return html
}
