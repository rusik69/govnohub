package web

templ LoginPage(csrf, errMsg, next string) {
	@Layout(LayoutData{
		Title: "Sign in", CSRF: csrf, HideNav: true,
		Content: loginContent(csrf, errMsg, next),
	})
}

templ loginContent(csrf, errMsg, next string) {
	<div class="login-box card p-6">
		<h1 class="text-2xl font-bold mb-4">Sign in to Govnohub</h1>
		@ErrorAlert(errMsg)
		<form method="post" action="/login" class="flex flex-col gap-4">
			@CSRFInput(csrf)
			<input type="hidden" name="next" value={ next }/>
			@FormField("Username or email", "login-username", "text", "username", "", true)
			@FormField("Password", "login-password", "password", "password", "", true)
			<button type="submit" class="btn w-full justify-center">Sign in</button>
		</form>
	</div>
}
