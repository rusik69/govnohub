package web

import (
	"github.com/rusik69/govnohub/internal/pull"
)

templ PullsPage(layout LayoutData, header RepoHeaderData, nav RepoNavData, prs []pull.PullRequest, state, defaultBranch, csrf string) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, Flash: layout.Flash, FlashErr: layout.FlashErr, FullWidth: true,
		Content: PullsContent(header, nav, prs, state, defaultBranch, csrf),
	})
}

templ PullsContent(header RepoHeaderData, nav RepoNavData, prs []pull.PullRequest, state, defaultBranch, csrf string) {
	@RepoPageShell(header, nav)
	<div class="max-w-7xl mx-auto">
		<div class="flex justify-between items-center mb-4 gap-3 flex-wrap">
			@PRSubhead(nav, prs, state)
			@CollapsibleForm("New pull request", PRCreateForm(nav, defaultBranch, csrf))
		</div>
		if len(filterPRs(prs, state)) == 0 {
			@EmptyState("No pull requests found")
		} else {
			<div class="gh-list">
				for _, pr := range filterPRs(prs, state) {
					@PRListItem(nav, pr)
				}
			</div>
		}
	</div>
}

templ PRCreateForm(nav RepoNavData, defaultBranch, csrf string) {
	<form method="post" action={ templ.SafeURL("/" + nav.Owner + "/" + nav.Repo + "/pulls") } class="grid grid-cols-2 gap-3">
		@CSRFInput(csrf)
		<input type="text" name="title" placeholder="PR title" required class="input col-span-2"/>
		<input type="text" name="head" placeholder="Head branch" required class="input"/>
		<input type="text" name="base" placeholder="Base branch" value={ defaultBranch } class="input"/>
		<textarea name="body" placeholder="Description" class="input col-span-2" rows="3"></textarea>
		<button type="submit" class="btn col-span-2">Open pull request</button>
	</form>
}

func filterPRs(prs []pull.PullRequest, state string) []pull.PullRequest {
	if state == "" || state == "open" {
		state = "open"
	}
	var out []pull.PullRequest
	for _, pr := range prs {
		if pr.State == state {
			out = append(out, pr)
		}
	}
	return out
}
