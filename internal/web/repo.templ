package web

import (
	gitstore "github.com/rusik69/govnohub/internal/git"
	"github.com/rusik69/govnohub/internal/repo"
)

type RepoPageData struct {
	Layout   LayoutData
	Header   RepoHeaderData
	Nav      RepoNavData
	Repo     *repo.Repository
	Path     string
	Ref      string
	Entries  []gitstore.TreeEntry
	Content  string
	IsBinary bool
}

templ RepoPage(data RepoPageData) {
	@Layout(LayoutData{
		Title: data.Layout.Title, User: data.Layout.User, CSRF: data.Layout.CSRF,
		UnreadNotifs: data.Layout.UnreadNotifs, FullWidth: true,
		Content: RepoContent(data),
	})
}

templ RepoContent(data RepoPageData) {
	<div class="max-w-7xl mx-auto">
		@RepoHeader(data.Header)
		@RepoNav(data.Nav)
		@BranchBar(data.Repo.FullName, data.Ref, data.Path)
		if data.Content != "" {
			<div class="gh-code-block">
				<pre class="font-mono whitespace-pre-wrap">{ data.Content }</pre>
			</div>
		} else if len(data.Entries) > 0 {
			@FileTable(data.Repo.FullName, data.Ref, data.Path, data.Entries)
		} else {
			<div class="gh-file-table">
				@EmptyState("This repository is empty")
			</div>
		}
	</div>
}

func repoEntryURL(fullName, ref, basePath string, e gitstore.TreeEntry) string {
	p := e.Path
	if basePath != "" {
		p = basePath + "/" + e.Path
	}
	if e.Type == "dir" {
		return "/" + fullName + "/tree/" + p + "?ref=" + ref
	}
	return "/" + fullName + "/blob/" + p + "?ref=" + ref
}
