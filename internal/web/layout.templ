package web

import (
	"strconv"

	"github.com/rusik69/govnohub/internal/auth"
)

type LayoutData struct {
	Title            string
	User             *SessionUser
	CSRF             string
	UnreadNotifs     int
	Content          templ.Component
	FullWidth        bool
	HideNav          bool
}

templ Layout(data LayoutData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="csrf-token" content={ data.CSRF }/>
			<title>{ data.Title } · Govnohub</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" integrity="sha384-HGfztofotfshcF7+8n44JBL2yH9sZz4MhyRgGO3rdv6j9sZ9rN8jdtJ0ZvW+hi87" crossorigin="anonymous"></script>
			<script>
				document.documentElement.classList.toggle('dark', localStorage.getItem('theme') === 'dark');
				function toggleTheme() {
					const dark = !document.documentElement.classList.contains('dark');
					document.documentElement.classList.toggle('dark', dark);
					localStorage.setItem('theme', dark ? 'dark' : 'light');
					updateThemeIcon();
				}
				function updateThemeIcon() {
					const dark = document.documentElement.classList.contains('dark');
					document.querySelectorAll('.theme-icon-sun').forEach(el => el.classList.toggle('hidden', dark));
					document.querySelectorAll('.theme-icon-moon').forEach(el => el.classList.toggle('hidden', !dark));
				}
				document.addEventListener('DOMContentLoaded', updateThemeIcon);
				document.addEventListener('htmx:configRequest', function(evt) {
					const token = document.querySelector('meta[name="csrf-token"]');
					if (token) evt.detail.headers['X-CSRF-Token'] = token.content;
				});
			</script>
		</head>
		<body class="min-h-screen">
			if !data.HideNav {
				<header class="gh-header">
					<div class="gh-header-inner">
						<a href="/" class="gh-header-mark" aria-label="Govnohub home" title="Govnohub">
							@Icon("mark-github", "")
						</a>
						if data.User != nil {
							<form action="/search" method="get" class="gh-header-search">
								@Icon("search", "")
								<input type="search" name="q" placeholder="Search or jump to..."/>
							</form>
						}
						<div class="gh-header-actions">
							<button type="button" class="gh-header-btn" onclick="toggleTheme()" title="Toggle theme">
								<span class="theme-icon-sun">
									@Icon("sun", "")
								</span>
								<span class="theme-icon-moon hidden">
									@Icon("moon", "")
								</span>
							</button>
							if data.User != nil {
								<div class="notif-bell">
									<button
										class="gh-header-btn"
										hx-get="/notifications"
										hx-target="#notif-panel"
										hx-swap="innerHTML"
										title="Notifications"
									>
										@Icon("bell", "")
									</button>
									if data.UnreadNotifs > 0 {
										<span class="notif-count">{ unreadLabel(data.UnreadNotifs) }</span>
									}
									<div id="notif-panel" class="notif-dropdown card hidden"></div>
								</div>
								<details class="gh-user-menu">
									<summary>
										@Avatar(data.User.Username, "")
										<span class="gh-header-link">{ data.User.Username }</span>
									</summary>
									<div class="gh-user-dropdown">
										<a href="/settings">Settings</a>
										if data.User.User != nil && data.User.User.Role == auth.RoleAdmin {
											<a href="/admin/users">Admin</a>
										}
										<form action="/logout" method="post">
											<input type="hidden" name="csrf_token" value={ data.CSRF }/>
											<button type="submit">Sign out</button>
										</form>
									</div>
								</details>
							} else {
								<a href="/login" class="gh-header-link">Sign in</a>
							}
						</div>
					</div>
				</header>
			}
			<main class={ layoutMainClass(data) }>
				@data.Content
			</main>
		</body>
	</html>
}

func layoutMainClass(data LayoutData) string {
	if data.FullWidth {
		return "p-4"
	}
	return "max-w-7xl mx-auto p-4"
}

func unreadLabel(n int) string {
	if n > 99 {
		return "99+"
	}
	return strconv.Itoa(n)
}
