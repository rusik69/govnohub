package web

import (
	"strconv"

	"github.com/rusik69/govnohub/internal/auth"
)

type LayoutData struct {
	Title            string
	User             *SessionUser
	CSRF             string
	UnreadNotifs     int
	Flash            string
	FlashErr         bool
	Content          templ.Component
	FullWidth        bool
	HideNav          bool
	ActiveNav        string
}

templ Layout(data LayoutData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="csrf-token" content={ data.CSRF }/>
			<title>{ data.Title } · Govnohub</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script>
				(function() {
					const stored = localStorage.getItem('theme');
					if (stored) {
						document.documentElement.classList.toggle('dark', stored === 'dark');
					} else {
						document.documentElement.classList.toggle('dark', window.matchMedia('(prefers-color-scheme: dark)').matches);
					}
				})();
				function toggleTheme() {
					const dark = !document.documentElement.classList.contains('dark');
					document.documentElement.classList.toggle('dark', dark);
					localStorage.setItem('theme', dark ? 'dark' : 'light');
					updateThemeIcon();
				}
				function updateThemeIcon() {
					const dark = document.documentElement.classList.contains('dark');
					document.querySelectorAll('.theme-icon-sun').forEach(el => el.classList.toggle('hidden', dark));
					document.querySelectorAll('.theme-icon-moon').forEach(el => el.classList.toggle('hidden', !dark));
					const btn = document.getElementById('theme-toggle');
					if (btn) btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
				}
				function toggleNotifications(btn) {
					const drawer = document.getElementById('notif-drawer');
					const overlay = document.getElementById('notif-overlay');
					if (!drawer) return;
					const isOpen = drawer.classList.toggle('open');
					overlay.classList.toggle('open', isOpen);
					btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
					if (isOpen && drawer.querySelector('#notif-body').innerHTML.trim() === '') {
						htmx.ajax('GET', '/notifications', {target: '#notif-body', swap: 'innerHTML'});
					}
				}
				function closeNotifications() {
					const drawer = document.getElementById('notif-drawer');
					const overlay = document.getElementById('notif-overlay');
					const btn = document.querySelector('.notif-bell button');
					if (drawer) drawer.classList.remove('open');
					if (overlay) overlay.classList.remove('open');
					if (btn) btn.setAttribute('aria-expanded', 'false');
				}
				document.addEventListener('DOMContentLoaded', function() {
					updateThemeIcon();
					/* Start auto-polling for new notification count */
					if (document.querySelector('.notif-bell')) {
						setInterval(function() {
							const badge = document.getElementById('notif-badge');
							if (badge && !document.getElementById('notif-drawer').classList.contains('open')) {
								htmx.ajax('GET', '/notifications/count', {target: '#notif-badge', swap: 'outerHTML'});
							}
						}, 15000);
					}
				});
				document.addEventListener('click', function(e) {
					const drawer = document.getElementById('notif-drawer');
					const bell = document.querySelector('.notif-bell');
					if (!drawer || !drawer.classList.contains('open')) return;
					if (bell && !bell.contains(e.target) && !drawer.contains(e.target)) {
						closeNotifications();
					}
				});
				document.addEventListener('htmx:configRequest', function(evt) {
					const token = document.querySelector('meta[name="csrf-token"]');
					if (token) evt.detail.headers['X-CSRF-Token'] = token.content;
				});
				function switchCloneTab(btn, tab) {
					const menu = btn.closest('.gh-clone-menu');
					if (!menu) return;
					menu.querySelectorAll('[data-clone-tab]').forEach(function(b) {
						const active = b === btn;
						b.classList.toggle('active', active);
						b.setAttribute('aria-selected', active ? 'true' : 'false');
					});
					const input = menu.querySelector('.gh-clone-url');
					const hint = menu.querySelector('.gh-clone-hint');
					if (input) input.value = tab === 'ssh' ? input.dataset.ssh : input.dataset.https;
					if (hint) hint.textContent = tab === 'ssh' ? hint.dataset.sshHint : hint.dataset.httpsHint;
				}
				function copyCloneUrl(btn) {
					const input = btn.closest('.gh-clone-url-row').querySelector('.gh-clone-url');
					if (!input) return;
					navigator.clipboard.writeText(input.value).then(function() {
						btn.setAttribute('aria-label', 'Copied');
						setTimeout(function() { btn.setAttribute('aria-label', 'Copy'); }, 2000);
					});
				}
				document.addEventListener('click', function(e) {
					document.querySelectorAll('.gh-clone-menu[open]').forEach(function(menu) {
						if (!menu.contains(e.target)) menu.removeAttribute('open');
					});
				});

				/* Markdown preview toggle */
				function setupMarkdownPreview(container) {
					if (!container) return;
					const tabs = container.querySelector('[data-md-tabs]');
					const writePane = container.querySelector('[data-md-write]');
					const previewPane = container.querySelector('[data-md-preview]');
					const textarea = writePane ? writePane.querySelector('textarea') : null;
					if (!tabs || !writePane || !previewPane || !textarea) return;

					tabs.addEventListener('click', function(e) {
						const btn = e.target.closest('[data-md-tab]');
						if (!btn) return;

						const isWrite = btn.getAttribute('data-md-tab') === 'write';
						const csrf = btn.getAttribute('data-csrf') || '';
						const metaToken = document.querySelector('meta[name="csrf-token"]');
						const token = csrf || (metaToken ? metaToken.content : '');

						tabs.querySelectorAll('[data-md-tab]').forEach(function(t) {
							t.classList.toggle('active', t === btn);
						});

						if (isWrite) {
							writePane.style.display = '';
							previewPane.style.display = 'none';
						} else {
							writePane.style.display = 'none';
							previewPane.style.display = '';
							const body = textarea.value;
							if (body.trim() === '') {
								previewPane.innerHTML = '<p class="text-muted text-sm">Nothing to preview.</p>';
								return;
							}
							previewPane.innerHTML = '<p class="text-muted text-sm">Loading preview...</p>';
							fetch('/preview-markdown', {
								method: 'POST',
								headers: {
									'Content-Type': 'application/x-www-form-urlencoded',
									'X-CSRF-Token': token
								},
								body: 'body=' + encodeURIComponent(body)
							})
							.then(function(r) { return r.text(); })
							.then(function(html) { previewPane.innerHTML = html; })
							.catch(function() { previewPane.innerHTML = '<p class="text-red text-sm">Preview failed.</p>'; });
						}
					});
				}

				document.addEventListener('DOMContentLoaded', function() {
					document.querySelectorAll('[data-md-container]').forEach(setupMarkdownPreview);
				});
				document.addEventListener('htmx:afterSwap', function(evt) {
					if (evt.detail.target) {
						evt.detail.target.querySelectorAll('[data-md-container]').forEach(setupMarkdownPreview);
					}
				});
			</script>
		</head>
		<body class="min-h-screen">
			<a href="#main-content" class="skip-link">Skip to main content</a>
			if !data.HideNav {
				<header class="gh-header">
					<div class="gh-header-inner">
						<button
							type="button"
							class="gh-header-btn gh-hamburger"
							aria-label="Toggle navigation"
							aria-expanded="false"
							aria-controls="mobile-nav"
							onclick="document.getElementById('mobile-nav').classList.toggle('open');"
						>
							<svg class="gh-icon" aria-hidden="true" viewBox="0 0 16 16"><path fill="currentColor" d="M1 2.75A.75.75 0 011.75 2h12.5a.75.75 0 010 1.5H1.75A.75.75 0 011 2.75zm0 5A.75.75 0 011.75 7h12.5a.75.75 0 010 1.5H1.75A.75.75 0 011 7.75zM1.75 12h12.5a.75.75 0 010 1.5H1.75a.75.75 0 010-1.5z"/></svg>
						</button>
						<a href="/" class="gh-header-mark" aria-label="Govnohub home" title="Govnohub">
							@Icon("mark-github", "")
						</a>
						if data.User != nil {
							<nav class="gh-global-nav" aria-label="Global">
								<a href="/" class={ globalNavClass(data.ActiveNav, "dashboard") }>Dashboard</a>
								<a href="/orgs" class={ globalNavClass(data.ActiveNav, "orgs") }>Organizations</a>
								<a href="/search" class={ globalNavClass(data.ActiveNav, "search") + " gh-header-search-mobile" }>Search</a>
							</nav>
							<form action="/search" method="get" class="gh-header-search">
								@Icon("search", "")
								<input type="search" name="q" placeholder="Search or jump to..." aria-label="Search"/>
							</form>
						}
						<div class="gh-header-actions">
							if data.User != nil {
								<a href="/search" class="gh-header-btn gh-header-search-mobile" aria-label="Search">
									@Icon("search", "")
								</a>
							}
							<button type="button" class="gh-header-btn" onclick="toggleTheme()" aria-label="Toggle theme" aria-pressed="false" id="theme-toggle">
								<span class="theme-icon-sun">
									@Icon("sun", "")
								</span>
								<span class="theme-icon-moon hidden">
									@Icon("moon", "")
								</span>
							</button>
							if data.User != nil {
								<div class="notif-bell">
									<button
										type="button"
										class="gh-header-btn"
										aria-label="Notifications"
										aria-expanded="false"
										aria-controls="notif-drawer"
										onclick="toggleNotifications(this)"
										hx-indicator="#notif-loading"
									>
										@Icon("bell", "")
									</button>
									if data.UnreadNotifs > 0 {
										<span id="notif-badge" class="notif-count">{ unreadLabel(data.UnreadNotifs) }</span>
									} else {
										<span id="notif-badge" class="notif-count" style="display:none">0</span>
									}
								</div>
								<!-- Notifications drawer -->
								<div id="notif-overlay" class="notif-overlay" onclick="closeNotifications()"></div>
								<div id="notif-drawer" class="notif-drawer" aria-labelledby="notif-drawer-title" role="dialog" aria-modal="true">
									<div class="notif-drawer-header">
										<h2 id="notif-drawer-title">Notifications</h2>
										<button type="button" class="notif-drawer-close" onclick="closeNotifications()" aria-label="Close">
											<svg class="gh-icon" aria-hidden="true" viewBox="0 0 16 16"><path fill="currentColor" d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/></svg>
										</button>
									</div>
									<div id="notif-body" class="notif-drawer-body">
										<div class="notif-empty">
											@Icon("bell", "")
											<p>No notifications</p>
										</div>
									</div>
								</div>
								<details class="gh-user-menu">
									<summary>
										@Avatar(data.User.Username, "")
										<span class="gh-header-link">{ data.User.Username }</span>
									</summary>
									<div class="gh-user-dropdown">
										<a href="/settings">Settings</a>
										if data.User.User != nil && data.User.User.Role == auth.RoleAdmin {
											<a href="/admin/users">Admin</a>
										}
										<form action="/logout" method="post">
											<input type="hidden" name="csrf_token" value={ data.CSRF }/>
											<button type="submit">Sign out</button>
										</form>
									</div>
								</details>
							} else {
								<a href="/login" class="gh-header-link">Sign in</a>
							}
						</div>
					</div>
					if data.User != nil {
						<nav id="mobile-nav" class="gh-mobile-nav" aria-label="Mobile navigation">
							<a href="/" class={ globalNavClass(data.ActiveNav, "dashboard") }>
								@Icon("repo", "")
								Dashboard
							</a>
							<a href="/orgs" class={ globalNavClass(data.ActiveNav, "orgs") }>
								@Icon("repo", "")
								Organizations
							</a>
							<a href="/search" class={ globalNavClass(data.ActiveNav, "search") }>
								@Icon("search", "")
								Search
							</a>
						</nav>
					}
					</header>
			}
			<main id="main-content" class={ layoutMainClass(data) }>
				if data.Flash != "" {
					if data.FlashErr {
						@ErrorAlert(data.Flash)
					} else {
						@Toast(data.Flash, "success")
					}
				}
				@data.Content
			</main>
		</body>
	</html>
}

func layoutMainClass(data LayoutData) string {
	if data.FullWidth {
		return "p-4"
	}
	return "max-w-7xl mx-auto p-4"
}

func globalNavClass(active, tab string) string {
	if active == tab {
		return "active"
	}
	return ""
}

func unreadLabel(n int) string {
	if n > 99 {
		return "99+"
	}
	return strconv.Itoa(n)
}
