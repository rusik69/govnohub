package web

import (
	"strconv"

	"github.com/rusik69/govnohub/internal/auth"
)

type LayoutData struct {
	Title            string
	User             *SessionUser
	CSRF             string
	UnreadNotifs     int
	Flash            string
	FlashErr         bool
	Content          templ.Component
	FullWidth        bool
	HideNav          bool
	ActiveNav        string
}

templ Layout(data LayoutData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="csrf-token" content={ data.CSRF }/>
			<title>{ data.Title } · Govnohub</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/github-hl.css" id="hljs-theme"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/highlight.min.js"></script>
			<script>
				(function() {
					const stored = localStorage.getItem('theme');
					if (stored) {
						document.documentElement.classList.toggle('dark', stored === 'dark');
					} else {
						document.documentElement.classList.toggle('dark', window.matchMedia('(prefers-color-scheme: dark)').matches);
					}
				})();
				function toggleTheme() {
					const dark = !document.documentElement.classList.contains('dark');
					document.documentElement.classList.toggle('dark', dark);
					localStorage.setItem('theme', dark ? 'dark' : 'light');
					updateThemeIcon();
					updateHLTheme(dark);
				}
				function updateHLTheme(dark) {
					const link = document.getElementById('hljs-theme');
					if (link) link.href = dark ? '/static/github-dark-hl.css' : '/static/github-hl.css';
				}
				function updateThemeIcon() {
					const dark = document.documentElement.classList.contains('dark');
					document.querySelectorAll('.theme-icon-sun').forEach(el => el.classList.toggle('hidden', dark));
					document.querySelectorAll('.theme-icon-moon').forEach(el => el.classList.toggle('hidden', !dark));
					const btn = document.getElementById('theme-toggle');
					if (btn) btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
					updateHLTheme(dark);
				}
				function highlightCodeBlocks() {
					document.querySelectorAll('.markdown pre code, .gh-code-block pre code').forEach(function(block) {
						if (!block.dataset.highlighted) {
							hljs.highlightElement(block);
							block.dataset.highlighted = 'yes';
						}
					});
				}
				function updateRelativeTimes() {
					document.querySelectorAll('time[datetime]').forEach(function(el) {
						var dt = new Date(el.getAttribute('datetime'));
						if (isNaN(dt.getTime())) return;
						var diff = Date.now() - dt.getTime();
						var seconds = Math.floor(diff / 1000);
						var minutes = Math.floor(seconds / 60);
						var hours = Math.floor(minutes / 60);
						var days = Math.floor(hours / 24);
						if (seconds < 60) {
							el.textContent = 'just now';
						} else if (minutes < 2) {
							el.textContent = '1m ago';
						} else if (minutes < 60) {
							el.textContent = minutes + 'm ago';
						} else if (hours < 2) {
							el.textContent = '1h ago';
						} else if (hours < 24) {
							el.textContent = hours + 'h ago';
						} else if (days < 2) {
							el.textContent = 'yesterday';
						} else if (days < 30) {
							el.textContent = days + 'd ago';
						} else {
							/* For old dates, keep the server-rendered text (e.g. "Jan 2") */
						}
					});
				}
				function toggleNotifications(btn) {
					const drawer = document.getElementById('notif-drawer');
					const overlay = document.getElementById('notif-overlay');
					if (!drawer) return;
					const isOpen = drawer.classList.toggle('open');
					overlay.classList.toggle('open', isOpen);
					btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
					if (isOpen && drawer.querySelector('#notif-body').innerHTML.trim() === '') {
						htmx.ajax('GET', '/notifications', {target: '#notif-body', swap: 'innerHTML'});
					}
				}
				function closeNotifications() {
					const drawer = document.getElementById('notif-drawer');
					const overlay = document.getElementById('notif-overlay');
					const btn = document.querySelector('.notif-bell button');
					if (drawer) drawer.classList.remove('open');
					if (overlay) overlay.classList.remove('open');
					if (btn) btn.setAttribute('aria-expanded', 'false');
				}
				document.addEventListener('DOMContentLoaded', function() {
					updateThemeIcon();
					highlightCodeBlocks();
					updateRelativeTimes();
					/* Start auto-polling for new notification count */
					if (document.querySelector('.notif-bell')) {
						setInterval(function() {
							const badge = document.getElementById('notif-badge');
							if (badge && !document.getElementById('notif-drawer').classList.contains('open')) {
								htmx.ajax('GET', '/notifications/count', {target: '#notif-badge', swap: 'outerHTML'});
							}
						}, 15000);
					}
				});
				document.addEventListener('click', function(e) {
					const drawer = document.getElementById('notif-drawer');
					const bell = document.querySelector('.notif-bell');
					if (!drawer || !drawer.classList.contains('open')) return;
					if (bell && !bell.contains(e.target) && !drawer.contains(e.target)) {
						closeNotifications();
					}
				});
				document.addEventListener('htmx:configRequest', function(evt) {
					const token = document.querySelector('meta[name="csrf-token"]');
					if (token) evt.detail.headers['X-CSRF-Token'] = token.content;
				});
				function switchCloneTab(btn, tab) {
					const menu = btn.closest('.gh-clone-menu');
					if (!menu) return;
					menu.querySelectorAll('[data-clone-tab]').forEach(function(b) {
						const active = b === btn;
						b.classList.toggle('active', active);
						b.setAttribute('aria-selected', active ? 'true' : 'false');
					});
					const input = menu.querySelector('.gh-clone-url');
					const hint = menu.querySelector('.gh-clone-hint');
					if (input) input.value = tab === 'ssh' ? input.dataset.ssh : input.dataset.https;
					if (hint) hint.textContent = tab === 'ssh' ? hint.dataset.sshHint : hint.dataset.httpsHint;
				}
				function copyCloneUrl(btn) {
					const input = btn.closest('.gh-clone-url-row').querySelector('.gh-clone-url');
					if (!input) return;
					navigator.clipboard.writeText(input.value).then(function() {
						btn.setAttribute('aria-label', 'Copied');
						setTimeout(function() { btn.setAttribute('aria-label', 'Copy'); }, 2000);
					});
				}
				/* Generic copy-to-clipboard with visual feedback */
				function copyToClipboard(text, btn) {
					navigator.clipboard.writeText(text).then(function() {
						var orig = btn.getAttribute('aria-label') || 'Copy';
						btn.setAttribute('aria-label', 'Copied!');
						btn.classList.add('copied');
						setTimeout(function() {
							btn.setAttribute('aria-label', orig);
							btn.classList.remove('copied');
						}, 2000);
					}).catch(function() {
						/* Fallback: select a hidden input if clipboard API fails */
						var input = document.createElement('input');
						input.value = text;
						input.style.position = 'fixed';
						input.style.opacity = '0';
						document.body.appendChild(input);
						input.select();
						document.execCommand('copy');
						document.body.removeChild(input);
						btn.setAttribute('aria-label', 'Copied!');
						setTimeout(function() { btn.setAttribute('aria-label', orig); }, 2000);
					});
				}
				document.addEventListener('click', function(e) {
					document.querySelectorAll('.gh-clone-menu[open]').forEach(function(menu) {
						if (!menu.contains(e.target)) menu.removeAttribute('open');
					});
				});

				/* Markdown preview toggle */
				function setupMarkdownPreview(container) {
					if (!container) return;
					const tabs = container.querySelector('[data-md-tabs]');
					const writePane = container.querySelector('[data-md-write]');
					const previewPane = container.querySelector('[data-md-preview]');
					const textarea = writePane ? writePane.querySelector('textarea') : null;
					if (!tabs || !writePane || !previewPane || !textarea) return;

					tabs.addEventListener('click', function(e) {
						const btn = e.target.closest('[data-md-tab]');
						if (!btn) return;

						const isWrite = btn.getAttribute('data-md-tab') === 'write';
						const csrf = btn.getAttribute('data-csrf') || '';
						const metaToken = document.querySelector('meta[name="csrf-token"]');
						const token = csrf || (metaToken ? metaToken.content : '');

						tabs.querySelectorAll('[data-md-tab]').forEach(function(t) {
							t.classList.toggle('active', t === btn);
						});

						if (isWrite) {
							writePane.style.display = '';
							previewPane.style.display = 'none';
						} else {
							writePane.style.display = 'none';
							previewPane.style.display = '';
							const body = textarea.value;
							if (body.trim() === '') {
								previewPane.innerHTML = '<p class="text-muted text-sm">Nothing to preview.</p>';
								return;
							}
							previewPane.innerHTML = '<p class="text-muted text-sm">Loading preview...</p>';
							fetch('/preview-markdown', {
								method: 'POST',
								headers: {
									'Content-Type': 'application/x-www-form-urlencoded',
									'X-CSRF-Token': token
								},
								body: 'body=' + encodeURIComponent(body)
							})
							.then(function(r) { return r.text(); })
							.then(function(html) { previewPane.innerHTML = html; })
							.catch(function() { previewPane.innerHTML = '<p class="text-red text-sm">Preview failed.</p>'; });
						}
					});
				}

				document.addEventListener('DOMContentLoaded', function() {
					document.querySelectorAll('[data-md-container]').forEach(setupMarkdownPreview);
				});
				document.addEventListener('htmx:afterSwap', function(evt) {
					if (evt.detail.target) {
						evt.detail.target.querySelectorAll('[data-md-container]').forEach(setupMarkdownPreview);
					}
				});
			/* --- Keyboard shortcuts --- */
			var _gk = null;
			function _clickNewIssue() {
				/* Try to click the "New issue" <summary> toggle to expand the form */
				var summaries = document.querySelectorAll('.collapsible-form summary');
				for (var i = 0; i < summaries.length; i++) {
					if (summaries[i].textContent.trim() === 'New issue') {
						summaries[i].click();
						return;
					}
				}
				/* Fallback: navigate to the issues page for the current repo */
				var m = window.location.pathname.match(/^\/([^\/]+)\/([^\/]+)\/.+/);
				if (m) window.location.href = '/' + m[1] + '/' + m[2] + '/issues';
			}
			document.addEventListener('keydown', function(e) {
				/* Ignore if focus is in an editable element */
				var tag = e.target.tagName;
				if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || e.target.isContentEditable) return;
				/* Ignore modifier keys */
				if (e.ctrlKey || e.altKey || e.metaKey) return;

				/* g leader sequence: wait for i or p within 1s */
				if (e.key === 'g') {
					_gk = 'g';
					setTimeout(function() { _gk = null; }, 1000);
					return;
				}
				if (_gk === 'g' && (e.key === 'i' || e.key === 'p')) {
					_gk = null;
					e.preventDefault();
					/* Extract owner/repo from path if on a repo page: /{owner}/{repo}/... */
					var m = window.location.pathname.match(/^\/([^\/]+)\/([^\/]+)\/.+/);
					var path;
					if (m) {
						path = '/' + m[1] + '/' + m[2] + (e.key === 'i' ? '/issues' : '/pulls');
					} else {
						path = '/search?q=' + (e.key === 'i' ? 'is:issue' : 'is:pr');
					}
					window.location.href = path;
					return;
				}
				_gk = null;

				/* c → new issue */
				if (e.key === 'c' && !e.shiftKey) {
					e.preventDefault();
					_clickNewIssue();
				}
			});
			/* --- User mention (@username) autocomplete --- */
			var _mentionData = null;
			function setupMentionAutocomplete(container) {
				if (!container) return;
				var ta = container.querySelector('textarea[data-mention-enabled]');
				if (!ta || ta._mentionSetup) return;
				ta._mentionSetup = true;
				ta.addEventListener('input', function(e) {
					var pos = ta.selectionStart;
					var val = ta.value;
					/* Find the @ before cursor: look backwards from cursor */
					var start = val.lastIndexOf('@', pos - 1);
					if (start === -1 || (start > 0 && val[start-1] !== ' ' && val[start-1] !== '	' && val[start-1] !== '\n' && val[start-1] !== '\r')) {
						_removeMentionDropdown();
						return;
					}
					var query = val.substring(start + 1, pos);
					/* Must match word characters only */
					if (query.length === 0 || !/^[a-zA-Z0-9_]+$/.test(query)) {
						_removeMentionDropdown();
						return;
					}
					_mentionData = { ta: ta, start: start, pos: pos, query: query };
					_fetchMentionSuggestions(query, ta);
				});
				ta.addEventListener('blur', function() {
					setTimeout(_removeMentionDropdown, 200);
				});
				ta.addEventListener('keydown', function(e) {
					var dd = document.getElementById('mention-dropdown');
					if (!dd || !dd._visible) return;
					var items = dd.querySelectorAll('.mention-item');
					var idx = Array.prototype.indexOf.call(items, dd.querySelector('.mention-item.active'));
					if (e.key === 'ArrowDown') {
						e.preventDefault();
						var next = idx < items.length - 1 ? idx + 1 : 0;
						items.forEach(function(i) { i.classList.remove('active'); });
						items[next].classList.add('active');
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						var prev = idx > 0 ? idx - 1 : items.length - 1;
						items.forEach(function(i) { i.classList.remove('active'); });
						items[prev].classList.add('active');
					} else if (e.key === 'Enter' || e.key === 'Tab') {
						if (idx >= 0 && items[idx]) {
							e.preventDefault();
							_applyMention(items[idx].textContent.trim());
						}
					} else if (e.key === 'Escape') {
						_removeMentionDropdown();
					}
				});
			}
			function _fetchMentionSuggestions(query, ta) {
				fetch('/users/search?q=' + encodeURIComponent(query))
					.then(function(r) { return r.json(); })
					.then(function(users) {
						if (!_mentionData || _mentionData.ta !== ta) return;
						if (!users || users.length === 0) {
							_removeMentionDropdown();
							return;
						}
						_showMentionDropdown(users, ta);
					})
					.catch(function() { _removeMentionDropdown(); });
			}
			function _showMentionDropdown(users, ta) {
				_removeMentionDropdown();
				var dd = document.createElement('div');
				dd.id = 'mention-dropdown';
				dd._visible = true;
				dd.className = 'mention-dropdown';
				users.forEach(function(u, i) {
					var item = document.createElement('div');
					item.className = 'mention-item' + (i === 0 ? ' active' : '');
					item.textContent = '@' + u;
					item.setAttribute('role', 'option');
					item.setAttribute('data-username', u);
					item.addEventListener('mousedown', function(e) {
						e.preventDefault();
						_applyMention(u);
					});
					item.addEventListener('mouseenter', function() {
						dd.querySelectorAll('.mention-item').forEach(function(el) { el.classList.remove('active'); });
						item.classList.add('active');
					});
					dd.appendChild(item);
				});
				/* Position below the textarea */
				var rect = ta.getBoundingClientRect();
				dd.style.position = 'fixed';
				dd.style.left = rect.left + 'px';
				dd.style.top = (rect.bottom + window.scrollY) + 'px';
				dd.style.minWidth = Math.max(rect.width * 0.4, 160) + 'px';
				dd.style.zIndex = '9999';
				document.body.appendChild(dd);
			}
			function _applyMention(username) {
				if (!_mentionData) return;
				var ta = _mentionData.ta;
				var start = _mentionData.start;
				var pos = _mentionData.pos;
				var val = ta.value;
				ta.value = val.substring(0, start) + '@' + username + ' ' + val.substring(pos);
				ta.selectionStart = ta.selectionEnd = start + username.length + 2;
				ta.focus();
				_removeMentionDropdown();
				_mentionData = null;
				/* Trigger input event for HTMX bindings */
				var evt = new Event('input', { bubbles: true });
				ta.dispatchEvent(evt);
			}
			function _removeMentionDropdown() {
				var dd = document.getElementById('mention-dropdown');
				if (dd) {
					dd._visible = false;
					dd.remove();
				}
			}
			/* --- Emoji (:shortcode:) autocomplete --- */
			var _emojiData = null;
			/* Standard GitHub emoji shortcodes — most commonly used subset */
			var EMOJI_MAP = {
				"smile": "\ud83d\ude04", "smiley": "\ud83d\ude03", "grinning": "\ud83d\ude00", "blush": "\ud83d\ude0a",
				"joy": "\ud83d\ude02", "sweat_smile": "\ud83d\ude05", "laughing": "\ud83d\ude06", "innocent": "\ud83d\ude07",
				"wink": "\ud83d\ude09", "heart_eyes": "\ud83d\ude0d", "kissing_heart": "\ud83d\ude18", "kissing": "\ud83d\ude17",
				"yum": "\ud83d\ude0b", "stuck_out_tongue": "\ud83d\ude1b", "sunglasses": "\ud83d\ude0e", "smirk": "\ud83d\ude0f",
				"unamused": "\ud83d\ude12", "sweat": "\ud83d\ude13", "pensive": "\ud83d\ude14", "confounded": "\ud83d\ude16",
				"cry": "\ud83d\ude22", "sob": "\ud83d\ude2d", "angry": "\ud83d\ude20", "rage": "\ud83d\ude21",
				"frowning": "\ud83d\ude26", "anguished": "\ud83d\ude27", "fearful": "\ud83d\ude28", "weary": "\ud83d\ude29",
				"sleepy": "\ud83d\ude2a", "tired_face": "\ud83d\ude2b", "grimacing": "\ud83d\ude2c", "cold_sweat": "\ud83d\ude30",
				"scream": "\ud83d\ude31", "astonished": "\ud83d\ude32", "flushed": "\ud83d\ude33", "dizzy_face": "\ud83d\ude35",
				"mask": "\ud83d\ude37", "neutral_face": "\ud83d\ude10", "expressionless": "\ud83d\ude11", "confused": "\ud83d\ude15",
				"thinking": "\ud83e\udd14", "slightly_smiling": "\ud83d\ude42", "slightly_frowning": "\ud83d\ude41",
				"hugging": "\ud83e\udd17", "rolling_eyes": "\ud83d\ude44", "money_mouth": "\ud83e\udd11", "nerd": "\ud83e\udd13",
				"thumbsup": "\ud83d\udc4d", "+1": "\ud83d\udc4d", "thumbsdown": "\ud83d\udc4e", "-1": "\ud83d\udc4e",
				"clap": "\ud83d\udc4f", "wave": "\ud83d\udc4b", "ok_hand": "\ud83d\udc4c", "v": "\u270c\ufe0f",
				"raised_hands": "\ud83d\ude4c", "pray": "\ud83d\ude4f", "point_up": "\u261d\ufe0f", "point_down": "\ud83d\udc47",
				"point_left": "\ud83d\udc48", "point_right": "\ud83d\udc49", "muscle": "\ud83d\udcaa", "eyes": "\ud83d\udc40",
				"heart": "\u2764\ufe0f", "broken_heart": "\ud83d\udc94", "two_hearts": "\ud83d\udc95", "sparkling_heart": "\ud83d\udc96",
				"heartpulse": "\ud83d\udc97", "cupid": "\ud83d\udc98", "star": "\u2b50", "sparkles": "\u2728",
				"zap": "\u26a1", "fire": "\ud83d\udd25", "rocket": "\ud83d\ude80", "checkered_flag": "\ud83c\udfc1",
				"tada": "\ud83c\udf89", "party": "\ud83c\udf8a", "confetti": "\ud83c\udf8a", "balloon": "\ud83c\udf88",
				"gift": "\ud83c\udf81", "crown": "\ud83d\udc51", "medal": "\ud83c\udfc5", "trophy": "\ud83c\udfc6",
				"100": "\ud83d\udcaf", "bookmark": "\ud83d\udd16", "link": "\ud83d\udd17", "pushpin": "\ud83d\udccc",
				"round_pushpin": "\ud83d\udccd", "bulb": "\ud83d\udca1", "warning": "\u26a0\ufe0f", "no_entry": "\u26d4",
				"x": "\u274c", "white_check_mark": "\u2705", "heavy_check_mark": "\u2714\ufe0f", "heavy_multiplication_x": "\u2716\ufe0f",
				"memo": "\ud83d\udcdd", "pencil": "\ud83d\udcdd", "page_facing_up": "\ud83d\udcc4", "book": "\ud83d\udcd6",
				"books": "\ud83d\udcda", "mag": "\ud83d\udd0d", "mag_right": "\ud83d\udd0e", "toolbox": "\ud83e\uddf0",
				"wrench": "\ud83d\udd27", "nut_and_bolt": "\ud83d\udd29", "hammer": "\ud83d\udd28", "gear": "\u2699\ufe0f",
				"bug": "\ud83d\udc1b", "ant": "\ud83d\udc1c", "beetle": "\ud83d\udc1e", "ladybug": "\ud83d\udc1e",
				"test_tube": "\ud83e\uddea", "microscope": "\ud83d\udd2c", "telescope": "\ud83d\udd2d", "satellite": "\ud83d\udce1",
				"computer": "\ud83d\udcbb", "laptop": "\ud83d\udcbb", "keyboard": "\u2328\ufe0f", "mouse": "\ud83d\uddb1\ufe0f",
				"battery": "\ud83d\udd0b", "electric_plug": "\ud83d\udd0c", "globe": "\ud83c\udf10", "earth": "\ud83c\udf0d",
				"map": "\ud83d\uddfa\ufe0f", "chart": "\ud83d\udcca", "bar_chart": "\ud83d\udcca", "file_folder": "\ud83d\udcc1",
				"open_file_folder": "\ud83d\udcc2", "inbox_tray": "\ud83d\udce5", "outbox_tray": "\ud83d\udce4",
				"envelope": "\u2709\ufe0f", "mailbox": "\ud83d\udceb", "incoming_envelope": "\ud83d\udce8",
				"phone": "\u260e\ufe0f", "telephone": "\u260e\ufe0f", "camera": "\ud83d\udcf7", "video_camera": "\ud83d\udcf9",
				"movie_camera": "\ud83c\udfa5", "clapper": "\ud83c\udfac", "musical_note": "\ud83c\udfb5", "notes": "\ud83c\udfb6",
				"musical_keyboard": "\ud83c\udfb9", "drum": "\ud83e\udd41", "guitar": "\ud83c\udfb8", "trumpet": "\ud83c\udfba",
				"saxophone": "\ud83c\udfb7", "microphone": "\ud83c\udfa4", "headphones": "\ud83c\udfa7", "radio": "\ud83d\udcfb",
				"watch": "\u231a", "hourglass": "\u23f3", "alarm_clock": "\u23f0", "calendar": "\ud83d\udcc5",
				"crystal_ball": "\ud83d\udd2e", "bank": "\ud83c\udfe6", "hospital": "\ud83c\udfe5", "school": "\ud83c\udfeb",
				"factory": "\ud83c\udfed", "office": "\ud83c\udfe2", "house": "\ud83c\udfe0", "construction": "\ud83c\udfd7\ufe0f",
				"european_castle": "\ud83c\udff0", "japanese_castle": "\ud83c\udfef", "beach": "\ud83c\udfd6\ufe0f", "desert": "\ud83c\udfdc\ufe0f",
				"car": "\ud83d\ude97", "taxi": "\ud83d\ude95", "bus": "\ud83d\ude8c", "truck": "\ud83d\ude9a",
				"ambulance": "\ud83d\ude91", "fire_engine": "\ud83d\ude92", "police_car": "\ud83d\ude93", "bicycle": "\ud83d\udeb2",
				"airplane": "\u2708\ufe0f", "helicopter": "\ud83d\ude81", "anchor": "\u2693", "ship": "\ud83d\udea2",
				"train": "\ud83d\ude82", "subway": "\ud83d\ude87", "rocket": "\ud83d\ude80", "star2": "\ud83c\udf1f",
				"sunny": "\u2600\ufe0f", "moon": "\ud83c\udf19", "cloud": "\u2601\ufe0f", "umbrella": "\u2614",
				"rainbow": "\ud83c\udf08", "snowflake": "\u2744\ufe0f", "snowman": "\u26c4", "tornado": "\ud83c\udf2a\ufe0f",
				"dog": "\ud83d\udc36", "cat": "\ud83d\udc31", "mouse": "\ud83d\udc2d", "hamster": "\ud83d\udc39",
				"rabbit": "\ud83d\udc30", "fox": "\ud83e\udd8a", "bear": "\ud83d\udc3b", "panda_face": "\ud83d\udc3c",
				"koala": "\ud83d\udc28", "tiger": "\ud83d\udc2f", "lion": "\ud83e\udd81", "cow": "\ud83d\udc2e",
				"pig": "\ud83d\udc37", "frog": "\ud83d\udc38", "monkey": "\ud83d\udc35", "chicken": "\ud83d\udc14",
				"baby_chick": "\ud83d\udc24", "bird": "\ud83d\udc26", "penguin": "\ud83d\udc27", "fish": "\ud83d\udc1f",
				"dolphin": "\ud83d\udc2c", "whale": "\ud83d\udc33", "octopus": "\ud83d\udc19", "turtle": "\ud83d\udc22",
				"snake": "\ud83d\udc0d", "dragon": "\ud83d\udc09", "unicorn": "\ud83e\udd84", "horse": "\ud83d\udc0e",
				"cactus": "\ud83c\udf35", "palm_tree": "\ud83c\udf34", "tree": "\ud83c\udf33", "seedling": "\ud83c\udf31",
				"herb": "\ud83c\udf3f", "four_leaf_clover": "\ud83c\udf40", "mushroom": "\ud83c\udf44", "cherry_blossom": "\ud83c\udf38",
				"rose": "\ud83c\udf39", "sunflower": "\ud83c\udf3b", "blossom": "\ud83c\udf3c", "tulip": "\ud83c\udf37",
				"seedling": "\ud83c\udf31", "maple_leaf": "\ud83c\udf41", "fallen_leaf": "\ud83c\udf42", "leaf": "\ud83c\udf43",
				"grapes": "\ud83c\udf47", "melon": "\ud83c\udf48", "watermelon": "\ud83c\udf49", "tangerine": "\ud83c\udf4a",
				"lemon": "\ud83c\udf4b", "banana": "\ud83c\udf4c", "pineapple": "\ud83c\udf4d", "apple": "\ud83c\udf4e",
				"green_apple": "\ud83c\udf4f", "pear": "\ud83c\udf50", "peach": "\ud83c\udf51", "cherries": "\ud83c\udf52",
				"strawberry": "\ud83c\udf53", "hamburger": "\ud83c\udf54", "pizza": "\ud83c\udf55", "fries": "\ud83c\udf5f",
				"hotdog": "\ud83c\udf2d", "taco": "\ud83c\udf2e", "burrito": "\ud83c\udf2f", "popcorn": "\ud83c\udf7f",
				"shrimp": "\ud83e\udd90", "egg": "\ud83e\udd5a", "bread": "\ud83c\udf5e", "cheese": "\ud83e\uddc0",
				"coffee": "\u2615", "tea": "\ud83c\udf75", "beer": "\ud83c\udf7a", "cocktail": "\ud83c\udf78",
				"soccer": "\u26bd", "basketball": "\ud83c\udfc0", "football": "\ud83c\udfc8", "baseball": "\u26be",
				"tennis": "\ud83c\udfbe", "golf": "\u26f3", "ski": "\ud83c\udfbf", "swimmer": "\ud83c\udfca",
				"surfer": "\ud83c\udfc4", "video_game": "\ud83c\udfae", "game_die": "\ud83c\udfb2", "slot_machine": "\ud83c\udfb0",
				"flag": "\ud83c\udfc1", "checkered_flag": "\ud83c\udfc1", "rainbow_flag": "\ud83c\udff3\ufe0f\u200d\ud83c\udf08"
			};
			/* Build an array of [shortcode, emoji] for ordering/searching */
			var EMOJI_ENTRIES = [];
			(function() {
				for (var key in EMOJI_MAP) {
					if (EMOJI_MAP.hasOwnProperty(key)) {
						EMOJI_ENTRIES.push([key, EMOJI_MAP[key]]);
					}
				}
			})();
			function setupEmojiAutocomplete(container) {
				if (!container) return;
				var ta = container.querySelector('textarea[data-emoji-enabled]');
				if (!ta || ta._emojiSetup) return;
				ta._emojiSetup = true;
				ta.addEventListener('input', function(e) {
					var pos = ta.selectionStart;
					var val = ta.value;
					/* Find the : before cursor: look backwards from cursor */
					var start = val.lastIndexOf(':', pos - 1);
					if (start === -1 || start === 0 || (start > 0 && val[start-1] !== ' ' && val[start-1] !== '	' && val[start-1] !== '\n' && val[start-1] !== '\r' && val[start-1] !== '(')) {
						_removeEmojiDropdown();
						return;
					}
					var query = val.substring(start + 1, pos);
					if (query.length === 0 || !/^[a-zA-Z0-9_+\-]+$/.test(query)) {
						_removeEmojiDropdown();
						return;
					}
					/* Check if we're inside a word — after the colon we need word chars only */
					/* If the character before the colon was alphanumeric, this is probably not an emoji */
					if (start > 0 && /[a-zA-Z0-9_]/.test(val[start-1])) {
						_removeEmojiDropdown();
						return;
					}
					_emojiData = { ta: ta, start: start, pos: pos, query: query };
					_showEmojiSuggestions(query, ta);
				});
				ta.addEventListener('blur', function() {
					/* Auto-replace complete shortcodes like :smile: */
					setTimeout(function() {
						if (!ta) return;
						var val = ta.value;
						ta.value = val.replace(/:([a-zA-Z0-9_+\-]+):/g, function(match, name) {
							return EMOJI_MAP[name.toLowerCase()] || match;
						});
					}, 300);
				});
				ta.addEventListener('keydown', function(e) {
					var dd = document.getElementById('emoji-dropdown');
					if (!dd || !dd._visible) return;
					var items = dd.querySelectorAll('.emoji-item');
					var idx = Array.prototype.indexOf.call(items, dd.querySelector('.emoji-item.active'));
					if (e.key === 'ArrowDown') {
						e.preventDefault();
						var next = idx < items.length - 1 ? idx + 1 : 0;
						items.forEach(function(i) { i.classList.remove('active'); });
						items[next].classList.add('active');
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						var prev = idx > 0 ? idx - 1 : items.length - 1;
						items.forEach(function(i) { i.classList.remove('active'); });
						items[prev].classList.add('active');
					} else if (e.key === 'Enter' || e.key === 'Tab') {
						if (idx >= 0 && items[idx]) {
							e.preventDefault();
							_applyEmoji(items[idx].dataset.emojiShortcode, items[idx].dataset.emojiChar);
						}
					} else if (e.key === 'Escape') {
						_removeEmojiDropdown();
					}
				});
			}
			function _showEmojiSuggestions(query, ta) {
				_removeEmojiDropdown();
				var lq = query.toLowerCase();
				var matches = [];
				for (var i = 0; i < EMOJI_ENTRIES.length; i++) {
					var entry = EMOJI_ENTRIES[i];
					if (entry[0].indexOf(lq) !== -1) {
						matches.push(entry);
						if (matches.length >= 8) break;
					}
				}
				if (matches.length === 0) return;
				var dd = document.createElement('div');
				dd.id = 'emoji-dropdown';
				dd._visible = true;
				dd.className = 'emoji-dropdown';
				matches.forEach(function(m, i) {
					var item = document.createElement('div');
					item.className = 'emoji-item' + (i === 0 ? ' active' : '');
					item.dataset.emojiShortcode = m[0];
					item.dataset.emojiChar = m[1];
					var charSpan = document.createElement('span');
					charSpan.className = 'emoji-char';
					charSpan.textContent = m[1];
					var labelSpan = document.createElement('span');
					labelSpan.className = 'emoji-label';
					labelSpan.textContent = ':' + m[0] + ':';
					item.appendChild(charSpan);
					item.appendChild(labelSpan);
					item.addEventListener('mousedown', function(e) {
						e.preventDefault();
						_applyEmoji(this.dataset.emojiShortcode, this.dataset.emojiChar);
					});
					item.addEventListener('mouseenter', function() {
						dd.querySelectorAll('.emoji-item').forEach(function(el) { el.classList.remove('active'); });
						this.classList.add('active');
					});
					dd.appendChild(item);
				});
				/* Position below the textarea */
				var rect = ta.getBoundingClientRect();
				dd.style.position = 'fixed';
				dd.style.left = rect.left + 'px';
				dd.style.top = (rect.bottom + window.scrollY) + 'px';
				dd.style.minWidth = Math.max(rect.width * 0.4, 180) + 'px';
				dd.style.zIndex = '9999';
				document.body.appendChild(dd);
			}
			function _applyEmoji(shortcode, emoji) {
				if (!_emojiData) return;
				var ta = _emojiData.ta;
				var start = _emojiData.start;
				var pos = _emojiData.pos;
				var val = ta.value;
				ta.value = val.substring(0, start) + emoji + ' ' + val.substring(pos);
				ta.selectionStart = ta.selectionEnd = start + emoji.length + 1;
				ta.focus();
				_removeEmojiDropdown();
				_emojiData = null;
				/* Trigger input event for HTMX bindings */
				var evt = new Event('input', { bubbles: true });
				ta.dispatchEvent(evt);
			}
			function _removeEmojiDropdown() {
				var dd = document.getElementById('emoji-dropdown');
				if (dd) {
					dd._visible = false;
					dd.remove();
				}
			}
			document.addEventListener('DOMContentLoaded', function() {
				document.querySelectorAll('[data-md-container]').forEach(setupMentionAutocomplete);
				document.querySelectorAll('[data-md-container]').forEach(setupEmojiAutocomplete);
			});
			document.addEventListener('htmx:afterSwap', function(evt) {
				if (evt.detail.target) {
					evt.detail.target.querySelectorAll('[data-md-container]').forEach(setupMentionAutocomplete);
					evt.detail.target.querySelectorAll('[data-md-container]').forEach(setupEmojiAutocomplete);
					highlightCodeBlocks();
					updateRelativeTimes();
				}
			});
			/* --- Inline image paste support --- */
			function setupImagePaste(container) {
				if (!container) return;
				var ta = container.querySelector('textarea');
				if (!ta || ta._pasteSetup) return;
				ta._pasteSetup = true;
				ta.addEventListener('paste', function(e) {
					var items = e.clipboardData && e.clipboardData.items;
					if (!items) return;
					var imageItem = null;
					for (var i = 0; i < items.length; i++) {
						if (items[i].type.indexOf('image/') === 0) {
							imageItem = items[i];
							break;
						}
					}
					if (!imageItem) return;
					e.preventDefault();
					var file = imageItem.getAsFile();
					if (!file) return;
					/* Show an uploading indicator */
					var pos = ta.selectionStart;
					var placeholder = '[Uploading image...]';
					ta.value = ta.value.substring(0, pos) + placeholder + ta.value.substring(ta.selectionEnd);
					ta.selectionStart = ta.selectionEnd = pos + placeholder.length;
					/* Determine repo context from URL path: /{owner}/{repo}/... */
					var m = window.location.pathname.match(/^\/([^\/]+)\/([^\/]+)\//);
					var uploadUrl = m ? '/' + m[1] + '/' + m[2] + '/upload-image' : '/upload-image';
					var formData = new FormData();
					formData.append('file', file, file.name || 'pasted-image.png');
					var token = document.querySelector('meta[name="csrf-token"]');
					var headers = {};
					if (token) headers['X-CSRF-Token'] = token.content;
					fetch(uploadUrl, {
						method: 'POST',
						headers: headers,
						body: formData
					})
					.then(function(resp) {
						if (!resp.ok) throw new Error('Upload failed: ' + resp.status);
						return resp.text();
					})
					.then(function(url) {
						var markdown = '![' + (file.name || 'image') + '](' + url + ')';
						var val = ta.value;
						var idx = val.indexOf(placeholder);
						if (idx !== -1) {
							ta.value = val.substring(0, idx) + markdown + val.substring(idx + placeholder.length);
							ta.selectionStart = ta.selectionEnd = idx + markdown.length;
						} else {
							/* Fallback: append at end */
							ta.value = val + '\n' + markdown;
							ta.selectionStart = ta.selectionEnd = ta.value.length;
						}
						ta.focus();
					})
					.catch(function(err) {
						var val = ta.value;
						var idx = val.indexOf(placeholder);
						if (idx !== -1) {
							ta.value = val.substring(0, idx) + val.substring(idx + placeholder.length);
						}
						ta.focus();
						/* Brief error flash */
						var errEl = document.createElement('div');
						errEl.className = 'text-red text-xs mt-1';
						errEl.textContent = 'Image upload failed: ' + err.message;
						var parent = ta.closest('[data-md-container]');
						if (parent) parent.appendChild(errEl);
						setTimeout(function() { if (errEl.parentNode) errEl.parentNode.removeChild(errEl); }, 3000);
					});
				});
			}
			document.addEventListener('DOMContentLoaded', function() {
				document.querySelectorAll('[data-md-container]').forEach(setupImagePaste);
			});
			document.addEventListener('htmx:afterSwap', function(evt) {
				if (evt.detail.target) {
					evt.detail.target.querySelectorAll('[data-md-container]').forEach(setupImagePaste);
				}
			});
			</script>
		</head>
		<body class="min-h-screen">
			<a href="#main-content" class="skip-link">Skip to main content</a>
			if !data.HideNav {
				<header class="gh-header">
					<div class="gh-header-inner">
						<button
							type="button"
							class="gh-header-btn gh-hamburger"
							aria-label="Toggle navigation"
							aria-expanded="false"
							aria-controls="mobile-nav"
							onclick="document.getElementById('mobile-nav').classList.toggle('open');"
						>
							<svg class="gh-icon" aria-hidden="true" viewBox="0 0 16 16"><path fill="currentColor" d="M1 2.75A.75.75 0 011.75 2h12.5a.75.75 0 010 1.5H1.75A.75.75 0 011 2.75zm0 5A.75.75 0 011.75 7h12.5a.75.75 0 010 1.5H1.75A.75.75 0 011 7.75zM1.75 12h12.5a.75.75 0 010 1.5H1.75a.75.75 0 010-1.5z"/></svg>
						</button>
						<a href="/" class="gh-header-mark" aria-label="Govnohub home" title="Govnohub">
							@Icon("mark-github", "")
						</a>
						if data.User != nil {
							<nav class="gh-global-nav" aria-label="Global">
								<a href="/" class={ globalNavClass(data.ActiveNav, "dashboard") }>Dashboard</a>
								<a href="/orgs" class={ globalNavClass(data.ActiveNav, "orgs") }>Organizations</a>
								<a href="/search" class={ globalNavClass(data.ActiveNav, "search") + " gh-header-search-mobile" }>Search</a>
							</nav>
							<form action="/search" method="get" class="gh-header-search">
								@Icon("search", "")
								<input type="search" name="q" placeholder="Search or jump to..." aria-label="Search"/>
							</form>
						}
						<div class="gh-header-actions">
							if data.User != nil {
								<a href="/search" class="gh-header-btn gh-header-search-mobile" aria-label="Search">
									@Icon("search", "")
								</a>
							}
							<button type="button" class="gh-header-btn" onclick="toggleTheme()" aria-label="Toggle theme" aria-pressed="false" id="theme-toggle">
								<span class="theme-icon-sun">
									@Icon("sun", "")
								</span>
								<span class="theme-icon-moon hidden">
									@Icon("moon", "")
								</span>
							</button>
							if data.User != nil {
								<div class="notif-bell">
									<button
										type="button"
										class="gh-header-btn"
										aria-label="Notifications"
										aria-expanded="false"
										aria-controls="notif-drawer"
										onclick="toggleNotifications(this)"
										hx-indicator="#notif-loading"
									>
										@Icon("bell", "")
									</button>
									if data.UnreadNotifs > 0 {
										<span id="notif-badge" class="notif-count">{ unreadLabel(data.UnreadNotifs) }</span>
									} else {
										<span id="notif-badge" class="notif-count" style="display:none">0</span>
									}
								</div>
								<!-- Notifications drawer -->
								<div id="notif-overlay" class="notif-overlay" onclick="closeNotifications()"></div>
								<div id="notif-drawer" class="notif-drawer" aria-labelledby="notif-drawer-title" role="dialog" aria-modal="true">
									<div class="notif-drawer-header">
										<h2 id="notif-drawer-title">Notifications</h2>
										<button type="button" class="notif-drawer-close" onclick="closeNotifications()" aria-label="Close">
											<svg class="gh-icon" aria-hidden="true" viewBox="0 0 16 16"><path fill="currentColor" d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/></svg>
										</button>
									</div>
									<div id="notif-body" class="notif-drawer-body">
										<div class="notif-empty">
											@Icon("bell", "")
											<p>No notifications</p>
										</div>
									</div>
								</div>
								<details class="gh-user-menu">
									<summary>
										@Avatar(data.User.Username, "")
										<span class="gh-header-link">{ data.User.Username }</span>
									</summary>
									<div class="gh-user-dropdown">
										<a href="/settings">Settings</a>
										if data.User.User != nil && data.User.User.Role == auth.RoleAdmin {
											<a href="/admin/users">Admin</a>
										}
										<form action="/logout" method="post">
											<input type="hidden" name="csrf_token" value={ data.CSRF }/>
											<button type="submit">Sign out</button>
										</form>
									</div>
								</details>
							} else {
								<a href="/login" class="gh-header-link">Sign in</a>
							}
						</div>
					</div>
					if data.User != nil {
						<nav id="mobile-nav" class="gh-mobile-nav" aria-label="Mobile navigation">
							<a href="/" class={ globalNavClass(data.ActiveNav, "dashboard") }>
								@Icon("repo", "")
								Dashboard
							</a>
							<a href="/orgs" class={ globalNavClass(data.ActiveNav, "orgs") }>
								@Icon("repo", "")
								Organizations
							</a>
							<a href="/search" class={ globalNavClass(data.ActiveNav, "search") }>
								@Icon("search", "")
								Search
							</a>
						</nav>
					}
					</header>
			}
			<main id="main-content" class={ layoutMainClass(data) }>
				if data.Flash != "" {
					if data.FlashErr {
						@ErrorAlert(data.Flash)
					} else {
						@Toast(data.Flash, "success")
					}
				}
				@data.Content
			</main>
			<div id="presence-indicator" class="gh-presence" style="display:none"></div>
			<script>
				(function() {
					var _presenceInterval = null;
					var _presencePollInterval = null;

					function startPresence() {
						var m = window.location.pathname.match(/^\/([^\/]+)\/([^\/]+)/);
						if (!m) return;
						var resource = m[1] + '/' + m[2];
						var indicator = document.getElementById('presence-indicator');
						if (!indicator) return;

						function heartbeat() {
							fetch('/api/v1/repos/' + resource + '/presence', { method: 'POST' }).catch(function() {});
						}

						function pollViewers() {
							fetch('/api/v1/repos/' + resource + '/presence')
								.then(function(r) { return r.json(); })
								.then(function(data) {
									if (data.count > 0) {
										indicator.style.display = 'inline-flex';
										indicator.innerHTML = '<span class="gh-presence-dot"></span> ' + data.count + ' viewer' + (data.count > 1 ? 's' : '');
									} else {
										indicator.style.display = 'none';
									}
								})
								.catch(function() {});
						}

						heartbeat();
						pollViewers();
						_presenceInterval = setInterval(heartbeat, 30000);
						_presencePollInterval = setInterval(pollViewers, 30000);
					}

					function stopPresence() {
						if (_presenceInterval) { clearInterval(_presenceInterval); _presenceInterval = null; }
						if (_presencePollInterval) { clearInterval(_presencePollInterval); _presencePollInterval = null; }
					}

					document.addEventListener('DOMContentLoaded', startPresence);
					/* Start auto-refreshing relative timestamps every 60 seconds */
					setInterval(updateRelativeTimes, 60000);

					document.addEventListener('htmx:afterSwap', function() {
						stopPresence();
						startPresence();
					});
				})();
			</script>
		</body>
	</html>
}

func layoutMainClass(data LayoutData) string {
	if data.FullWidth {
		return "p-4"
	}
	return "max-w-7xl mx-auto p-4"
}

func globalNavClass(active, tab string) string {
	if active == tab {
		return "active"
	}
	return ""
}

func unreadLabel(n int) string {
	if n > 99 {
		return "99+"
	}
	return strconv.Itoa(n)
}
