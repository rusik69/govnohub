package web

import (
	"github.com/rusik69/govnohub/internal/org"
	"github.com/rusik69/govnohub/internal/repo"
)

templ DashboardPage(layout LayoutData, repos []repo.Repository, orgs []org.Org, csrf string, errMsg string) {
	@Layout(LayoutData{
		Title: layout.Title, User: layout.User, CSRF: layout.CSRF,
		UnreadNotifs: layout.UnreadNotifs, ActiveNav: "dashboard",
		Content: DashboardContent(repos, orgs, csrf, errMsg),
	})
}

templ DashboardContent(repos []repo.Repository, orgs []org.Org, csrf string, errMsg string) {
	@PageHeader("Dashboard", DashboardActions(orgs, csrf))
	if errMsg != "" {
		@ErrorAlert(errMsg)
	}
	<div class="grid grid-cols-2 gap-6">
		<section>
			<h2 class="text-lg font-semibold mb-3">Your repositories</h2>
			if len(repos) == 0 {
				@EmptyState("No repositories yet")
			} else {
				<div class="gh-list">
					for _, r := range repos {
						<a href={ templ.SafeURL("/" + r.FullName) } class="gh-list-item">
							<span class="gh-list-item-icon">
								@Icon("repo", "")
							</span>
							<div class="gh-list-item-body">
								<div class="gh-list-item-title">{ r.FullName }</div>
								<div class="gh-list-item-meta">
									if r.IsPrivate {
										<span class="gh-visibility">Private</span>
									} else {
										<span class="gh-visibility">Public</span>
									}
									if r.Description != "" {
										<span> · { r.Description }</span>
									}
									<span> · Updated { r.UpdatedAt.Format("Jan 2, 2006") }</span>
								</div>
							</div>
						</a>
					}
				</div>
			}
		</section>
		<section>
			<h2 class="text-lg font-semibold mb-3">Organizations</h2>
			if len(orgs) == 0 {
				@EmptyState("No organizations")
			} else {
				<div class="gh-list">
					for _, o := range orgs {
						<a href={ templ.SafeURL("/orgs/" + o.Name) } class="gh-list-item">
							<span class="gh-list-item-icon">
								@Icon("repo", "")
							</span>
							<div class="gh-list-item-body">
								<div class="gh-list-item-title">{ o.Name }</div>
								if o.Description != "" {
									<div class="gh-list-item-meta">{ o.Description }</div>
								}
							</div>
						</a>
					}
				</div>
			}
			<a href="/orgs" class="btn-secondary mt-4 inline-flex">View all orgs</a>
		</section>
	</div>
}

templ DashboardActions(orgs []org.Org, csrf string) {
	<details class="collapsible-form">
		<summary class="btn">New repository</summary>
		<form method="post" action="/repos/create" class="card p-4 mt-2 flex flex-col gap-3" style="min-width:16rem">
			@CSRFInput(csrf)
			@FormField("Name", "repo-name", "text", "name", "", true)
			@FormField("Description", "repo-desc", "text", "description", "", false)
			<button type="submit" class="btn self-start">Create</button>
		</form>
	</details>
	if len(orgs) > 0 {
		<a href={ templ.SafeURL("/orgs/" + orgs[0].Name) } class="btn-secondary">Create in org</a>
	}
	<a href="/orgs" class="btn-secondary">Browse orgs</a>
}
