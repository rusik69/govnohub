package web

import (
	"strconv"
	"strings"
	"time"

	"github.com/rusik69/govnohub/internal/notification"
)

templ NotificationsPartial(notifs []notification.Notification, csrf string) {
	if len(notifs) == 0 {
		<div class="notif-empty">
			@Icon("bell", "")
			<p>No notifications</p>
		</div>
	} else {
		for _, n := range notifs {
			<div class={ "notif-item" + notifItemClass(n.Read) }>
				<div class="notif-item-icon">
					if n.Link != "" {
						if strings.Contains(n.Link, "/pulls/") {
							@Icon("git-pull-request", "notif-icon-pr")
						} else if strings.Contains(n.Link, "/issues/") {
							@Icon("issue-opened", "notif-icon-issue")
						} else if strings.Contains(n.Link, "/releases/") {
							@Icon("tag", "notif-icon-release")
						} else if strings.Contains(n.Link, "/actions/") {
							@Icon("play", "")
						} else if strings.Contains(n.Body, "review") || strings.Contains(n.Title, "review") {
							@Icon("comment", "notif-icon-review")
						} else {
							@Icon("bell", "notif-icon-comment")
						}
					} else {
						@Icon("bell", "notif-icon-comment")
					}
				</div>
				<div class="notif-item-content">
					<p class="notif-item-title">
						if !n.Read {
							<span class="notif-unread-dot" style="margin-right:0.375rem;vertical-align:middle"></span>
						}
						{ n.Title }
					</p>
					if n.Body != "" {
						<p class="notif-item-body">{ n.Body }</p>
					}
					<div class="notif-item-meta">
						if n.Link != "" {
							<a href={ templ.SafeURL(n.Link) } class="text-xs">View</a>
							<span aria-hidden="true">·</span>
						}
						<time datetime={ n.CreatedAt.Format(time.RFC3339) } title={ n.CreatedAt.Format("Jan 2, 2006 3:04 PM") }>{ relativeTime(n.CreatedAt) }</time>
					</div>
				</div>
				if !n.Read {
					<div class="notif-item-action">
						<button
							type="button"
							class="btn-secondary text-xs"
							style="padding:2px 6px;white-space:nowrap"
							hx-post={ "/notifications/" + n.ID.String() + "/read" }
							hx-target="#notif-body"
							hx-swap="innerHTML"
							title="Mark as read"
						>
							@Icon("check", "")
						</button>
					</div>
				}
			</div>
		}
	}
}

func notifItemClass(read bool) string {
	if read {
		return ""
	}
	return " unread"
}

func relativeTime(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < 2*time.Minute:
		return "1m ago"
	case d < time.Hour:
		return strconv.Itoa(int(d.Minutes())) + "m ago"
	case d < 2*time.Hour:
		return "1h ago"
	case d < 24*time.Hour:
		return strconv.Itoa(int(d.Hours())) + "h ago"
	case d < 48*time.Hour:
		return "yesterday"
	case d < 30*24*time.Hour:
		return strconv.Itoa(int(d.Hours()/24)) + "d ago"
	default:
		return t.Format("Jan 2")
	}
}

templ NotifBadge(count int) {
	if count > 0 {
		<span id="notif-badge" class="notif-count">{ unreadLabel(count) }</span>
	} else {
		<span id="notif-badge" class="notif-count" style="display:none">0</span>
	}
}
